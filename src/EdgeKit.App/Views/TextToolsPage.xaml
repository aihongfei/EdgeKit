<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="EdgeKit.App.Views.TextToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    RequestedTheme="Dark"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="PanelBorderStyle" TargetType="Border" BasedOn="{StaticResource EdgeCardBorderStyle}">
            <Setter Property="Background" Value="{ThemeResource EdgeCardBrush}" />
        </Style>

        <Style x:Key="EditorHostBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{ThemeResource EdgeControlBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource EdgeLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="EditorPreviewBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="{ThemeResource EdgeControlBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource EdgeLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="EditorLoadingOverlayStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{ThemeResource EdgeBackdropBrush}" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <Style x:Key="ToolButtonStyle" TargetType="Button" BasedOn="{StaticResource EdgeToolButtonStyle}">
            <Setter Property="MinWidth" Value="72" />
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource EdgeToolButtonStyle}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Page.Resources>

    <Grid Padding="24,16,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Text="文本工具"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource EdgeTextBrush}" />
                <TextBlock x:Name="SubtitleText"
                           Text="JSON 编辑器"
                           FontSize="12"
                           Foreground="{ThemeResource EdgeMutedBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="JsonTabButton"
                        MinWidth="92"
                        Height="38"
                        Click="OnJsonTabClick">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon FontSize="13" Glyph="&#xE943;" />
                        <TextBlock Text="JSON" />
                    </StackPanel>
                </Button>
                <Button x:Name="EncodingTabButton"
                        MinWidth="104"
                        Height="38"
                        Click="OnEncodingTabClick">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon FontSize="13" Glyph="&#xE8C1;" />
                        <TextBlock Text="编码转换" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid x:Name="JsonToolbar"
              Grid.Row="1"
              ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ScrollViewer HorizontalScrollMode="Auto"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollMode="Disabled"
                          VerticalScrollBarVisibility="Hidden">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="格式化" Style="{StaticResource ToolButtonStyle}" Click="OnJsonFormatClick" />
                    <Button Content="压缩" Style="{StaticResource ToolButtonStyle}" Click="OnJsonCompactClick" />
                    <Button Content="校验" Style="{StaticResource ToolButtonStyle}" Click="OnJsonValidateClick" />
                    <Button Content="转义" Style="{StaticResource ToolButtonStyle}" Click="OnJsonEscapeClick" />
                    <Button Content="反转义" Style="{StaticResource ToolButtonStyle}" Click="OnJsonUnescapeClick" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Style="{StaticResource IconButtonStyle}" Click="OnJsonFindClick" ToolTipService.ToolTip="搜索 Ctrl+F">
                    <FontIcon FontSize="14" Glyph="&#xE721;" />
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Click="OnJsonReplaceClick" ToolTipService.ToolTip="替换 Ctrl+R">
                    <FontIcon FontSize="14" Glyph="&#xE8AC;" />
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Click="OnJsonPasteClick" ToolTipService.ToolTip="粘贴">
                    <FontIcon FontSize="14" Glyph="&#xE77F;" />
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Click="OnJsonCopyClick" ToolTipService.ToolTip="复制">
                    <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Click="OnJsonClearClick" ToolTipService.ToolTip="清空">
                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Border x:Name="JsonPanel"
                    Style="{StaticResource PanelBorderStyle}">
                <Border Style="{StaticResource EditorHostBorderStyle}">
                    <controls:WebView2 x:Name="JsonEditor"
                                       MinHeight="460" />
                </Border>
            </Border>

            <Grid x:Name="EncodingPanel"
                  Visibility="Collapsed"
                  ColumnSpacing="12"
                  MinHeight="460">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource PanelBorderStyle}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="输入"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource EdgeTextBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="支持粘贴/拖入图片"
                                       FontSize="12"
                                       Foreground="{ThemeResource EdgeMutedBrush}" />
                        </Grid>

                        <Border x:Name="EncodingInputDropZone"
                                Grid.Row="1"
                                AllowDrop="True"
                                Style="{StaticResource EditorHostBorderStyle}"
                                DragOver="OnEncodingInputDragOver"
                                Drop="OnEncodingInputDrop">
                            <Grid>
                                <controls:WebView2 x:Name="EncodingInputEditor"
                                                   MinHeight="296" />
                                <Border x:Name="EncodingInputImagePanel"
                                        Style="{StaticResource EditorPreviewBorderStyle}"
                                        Visibility="Collapsed">
                                    <Grid RowSpacing="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Image x:Name="EncodingInputImagePreview"
                                               MinHeight="260"
                                               Stretch="Uniform" />
                                        <TextBlock x:Name="EncodingInputImageInfo"
                                                   Grid.Row="1"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource EdgeMutedBrush}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                                <Border x:Name="EncodingLoadingOverlay"
                                        Style="{StaticResource EditorLoadingOverlayStyle}">
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Spacing="10">
                                        <ProgressRing x:Name="EncodingProgressRing"
                                                      Width="42"
                                                      Height="42"
                                                      IsActive="False" />
                                        <TextBlock x:Name="EncodingLoadingText"
                                                   FontSize="13"
                                                   Foreground="{ThemeResource EdgeTextBrush}"
                                                   Text="正在处理..."
                                                   TextAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2" ColumnSpacing="8" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Row="0" Grid.Column="0" Content="URL 编码" Style="{StaticResource ToolButtonStyle}" HorizontalAlignment="Stretch" Click="OnUrlEncodeClick" />
                            <Button Grid.Row="0" Grid.Column="1" Content="URL 解码" Style="{StaticResource ToolButtonStyle}" HorizontalAlignment="Stretch" Click="OnUrlDecodeClick" />
                            <Button Grid.Row="1" Grid.Column="0" Content="Base64 编码" Style="{StaticResource ToolButtonStyle}" HorizontalAlignment="Stretch" Click="OnBase64EncodeClick" />
                            <Button Grid.Row="1" Grid.Column="1" Content="Base64 解码" Style="{StaticResource ToolButtonStyle}" HorizontalAlignment="Stretch" Click="OnBase64DecodeClick" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="输出"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource EdgeTextBrush}" />
                        <Border Grid.Row="1" Style="{StaticResource EditorHostBorderStyle}">
                            <Grid>
                                <controls:WebView2 x:Name="EncodingOutputEditor"
                                                   MinHeight="296" />
                                <Border x:Name="ImagePreviewPanel"
                                        Style="{StaticResource EditorPreviewBorderStyle}"
                                        Visibility="Collapsed">
                                <Grid RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Image x:Name="DecodedImagePreview"
                                           MinHeight="260"
                                           Stretch="Uniform" />
                                    <TextBlock x:Name="DecodedImageInfo"
                                               Grid.Row="1"
                                               FontSize="12"
                                               Foreground="{ThemeResource EdgeMutedBrush}"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                            <Border x:Name="EncodingOutputLoadingOverlay"
                                    Style="{StaticResource EditorLoadingOverlayStyle}">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="10">
                                    <ProgressRing x:Name="EncodingOutputProgressRing"
                                                  Width="42"
                                                  Height="42"
                                                  IsActive="False" />
                                    <TextBlock x:Name="EncodingOutputLoadingText"
                                               FontSize="13"
                                               Foreground="{ThemeResource EdgeTextBrush}"
                                               Text="正在处理..."
                                               TextAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        </Border>

                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="8">
                            <Button Style="{StaticResource IconButtonStyle}" Click="OnEncodingPasteClick" ToolTipService.ToolTip="粘贴">
                                <FontIcon FontSize="14" Glyph="&#xE77F;" />
                            </Button>
                            <Button Style="{StaticResource IconButtonStyle}" Click="OnEncodingCopyClick" ToolTipService.ToolTip="复制">
                                <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                            </Button>
                            <Button Style="{StaticResource IconButtonStyle}" Click="OnEncodingClearClick" ToolTipService.ToolTip="清空">
                                <FontIcon FontSize="14" Glyph="&#xE74D;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <TextBlock x:Name="StatusText"
                   Grid.Row="3"
                   Text="就绪"
                   FontSize="12"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Foreground="{ThemeResource EdgeMutedBrush}" />
    </Grid>
</Page>
