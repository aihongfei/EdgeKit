<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="EdgeKit.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    RequestedTheme="Dark"
    mc:Ignorable="d">

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="18" HorizontalAlignment="Stretch">

            <TextBlock Text="设置" FontSize="22" FontWeight="SemiBold"
                       Foreground="{ThemeResource EdgeTextBrush}" />

            <InfoBar x:Name="StartupLaunchErrorBar"
                     IsOpen="False"
                     Severity="Error"
                     IsClosable="True" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="开机自启" Foreground="{ThemeResource EdgeTextBrush}" />
                    <TextBlock Text="登录 Windows 后在后台启动 EdgeKit，托盘、快捷键和边缘触发保持可用"
                               FontSize="12" Foreground="{ThemeResource EdgeMutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch x:Name="StartupLaunchSwitch" Grid.Column="1"
                              VerticalAlignment="Center"
                              Toggled="OnStartupLaunchToggled" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="全局快捷键" Foreground="{ThemeResource EdgeTextBrush}" />
                    <TextBlock Text="按下快捷键后打开抽屉并自动聚焦搜索框"
                               FontSize="12" Foreground="{ThemeResource EdgeMutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <TextBox x:Name="GlobalHotkeyBox" Grid.Column="1"
                         Width="190" Height="36" VerticalAlignment="Center"
                         IsReadOnly="True"
                         PlaceholderText="按下快捷键"
                         PointerPressed="OnGlobalHotkeyBoxPointerPressed"
                         GotFocus="OnGlobalHotkeyBoxGotFocus"
                         LostFocus="OnGlobalHotkeyBoxLostFocus"
                         KeyDown="OnGlobalHotkeyKeyDown"
                         KeyUp="OnGlobalHotkeyKeyUp" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="搜索框默认启用 Everything" Foreground="{ThemeResource EdgeTextBrush}" />
                    <TextBlock Text="开启后搜索框优先走 Everything；关闭则保持本地搜索"
                               FontSize="12" Foreground="{ThemeResource EdgeMutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch x:Name="UseEverythingSearchSwitch" Grid.Column="1"
                              VerticalAlignment="Center"
                              Toggled="OnUseEverythingSearchToggled" />
            </Grid>

            <!-- 抽屉 -->
            <TextBlock Text="抽屉" FontSize="14" FontWeight="SemiBold"
                       Foreground="{ThemeResource EdgeMutedBrush}" Margin="0,4,0,0" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="抽屉宽度" Foreground="{ThemeResource EdgeTextBrush}" />
                    <TextBlock Text="抽屉滑出时的基础宽度（最小 360 像素，最大为屏幕宽度的 80%），也可拖拽右边缘调整"
                               FontSize="12" Foreground="{ThemeResource EdgeMutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <NumberBox x:Name="DrawerWidthBox" Grid.Column="1" Width="190" Height="36" VerticalAlignment="Center"
                           Minimum="360" SmallChange="10" LargeChange="50"
                           SpinButtonPlacementMode="Inline"
                           ValueChanged="OnDrawerWidthChanged" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="侧边菜单默认展开" Foreground="{ThemeResource EdgeTextBrush}" />
                    <TextBlock Text="开启则展开显示文字，关闭则收缩为图标窄条"
                               FontSize="12" Foreground="{ThemeResource EdgeMutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch x:Name="MenuExpandedSwitch" Grid.Column="1"
                              VerticalAlignment="Center"
                              Toggled="OnMenuExpandedToggled" />
            </Grid>

            <!-- 触发与行为 -->
            <TextBlock Text="触发与行为" FontSize="14" FontWeight="SemiBold"
                       Foreground="{ThemeResource EdgeMutedBrush}" Margin="0,4,0,0" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="触发边缘" Foreground="{ThemeResource EdgeTextBrush}" />
                    <TextBlock Text="光标触碰选定屏幕边缘时显示呼出长条"
                               FontSize="12" Foreground="{ThemeResource EdgeMutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <ComboBox x:Name="TriggerSidesBox" Grid.Column="1"
                          Width="190" Height="36" VerticalAlignment="Center"
                          SelectionChanged="OnTriggerSidesChanged">
                    <ComboBoxItem Content="左侧" Tag="Left" />
                    <ComboBoxItem Content="右侧" Tag="Right" />
                    <ComboBoxItem Content="两侧" Tag="Both" />
                </ComboBox>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="呼出长条宽度" Foreground="{ThemeResource EdgeTextBrush}" />
                    <TextBlock Text="触碰边缘后显示的长条宽度（像素，24-80）"
                               FontSize="12" Foreground="{ThemeResource EdgeMutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <NumberBox x:Name="EdgeHandleWidthBox" Grid.Column="1" Width="190" Height="36" VerticalAlignment="Center"
                           Minimum="24" Maximum="80" SmallChange="2" LargeChange="8"
                           SpinButtonPlacementMode="Inline"
                           ValueChanged="OnEdgeHandleWidthChanged" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="呼出长条高度" Foreground="{ThemeResource EdgeTextBrush}" />
                    <TextBlock Text="长条垂直居中显示，最小 120 像素，最大按当前屏幕高度限制"
                               FontSize="12" Foreground="{ThemeResource EdgeMutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <NumberBox x:Name="EdgeHandleHeightBox" Grid.Column="1" Width="190" Height="36" VerticalAlignment="Center"
                           Minimum="120" SmallChange="10" LargeChange="50"
                           SpinButtonPlacementMode="Inline"
                           ValueChanged="OnEdgeHandleHeightChanged" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="自动收起延迟" Foreground="{ThemeResource EdgeTextBrush}" />
                    <TextBlock Text="光标离开抽屉后等待此时长再收起（毫秒）"
                               FontSize="12" Foreground="{ThemeResource EdgeMutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <NumberBox x:Name="AutoHideDelayBox" Grid.Column="1" Width="190" Height="36" VerticalAlignment="Center"
                           Minimum="0" Maximum="5000" SmallChange="50" LargeChange="200"
                           SpinButtonPlacementMode="Inline"
                           ValueChanged="OnAutoHideDelayChanged" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="动画时长" Foreground="{ThemeResource EdgeTextBrush}" />
                    <TextBlock Text="滑入/滑出动画时长（毫秒）"
                               FontSize="12" Foreground="{ThemeResource EdgeMutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <NumberBox x:Name="AnimationDurationBox" Grid.Column="1" Width="190" Height="36" VerticalAlignment="Center"
                           Minimum="0" Maximum="1000" SmallChange="20" LargeChange="50"
                           SpinButtonPlacementMode="Inline"
                           ValueChanged="OnAnimationDurationChanged" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="全屏应用中禁用" Foreground="{ThemeResource EdgeTextBrush}" />
                    <TextBlock Text="开启后在全屏应用（如游戏、视频）中不触发抽屉"
                               FontSize="12" Foreground="{ThemeResource EdgeMutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch x:Name="DisableInFullscreenSwitch" Grid.Column="1"
                              VerticalAlignment="Center"
                              Toggled="OnDisableInFullscreenToggled" />
            </Grid>

            <!-- 首页与隐私 -->
            <TextBlock Text="首页与隐私" FontSize="14" FontWeight="SemiBold"
                       Foreground="{ThemeResource EdgeMutedBrush}" Margin="0,4,0,0" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="记录最近活动窗口" Foreground="{ThemeResource EdgeTextBrush}" />
                    <TextBlock Text="在首页展示最近切换过的应用窗口；关闭后不再记录"
                               FontSize="12" Foreground="{ThemeResource EdgeMutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch x:Name="TrackRecentWindowsSwitch" Grid.Column="1"
                              VerticalAlignment="Center"
                              Toggled="OnTrackRecentWindowsToggled" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="记录最近使用" Foreground="{ThemeResource EdgeTextBrush}" />
                    <TextBlock Text="在首页展示最近使用过的工具和应用；关闭后不再记录"
                               FontSize="12" Foreground="{ThemeResource EdgeMutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch x:Name="TrackRecentToolsSwitch" Grid.Column="1"
                              VerticalAlignment="Center"
                              Toggled="OnTrackRecentToolsToggled" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="最近使用显示行数" Foreground="{ThemeResource EdgeTextBrush}" />
                    <TextBlock Text="控制首页最近使用区可见行数，超出后可上下滚动（1-4）"
                               FontSize="12" Foreground="{ThemeResource EdgeMutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <NumberBox x:Name="RecentToolsVisibleRowsBox" Grid.Column="1"
                           Width="190" Height="36" VerticalAlignment="Center"
                           Minimum="1" Maximum="4" SmallChange="1" LargeChange="1"
                           SpinButtonPlacementMode="Inline"
                           ValueChanged="OnRecentToolsVisibleRowsChanged" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="首页展示剪贴板历史" Foreground="{ThemeResource EdgeTextBrush}" />
                    <TextBlock Text="在首页展示最近 5 条剪贴板历史"
                               FontSize="12" Foreground="{ThemeResource EdgeMutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch x:Name="ShowHomeClipboardHistorySwitch" Grid.Column="1"
                              VerticalAlignment="Center"
                              Toggled="OnShowHomeClipboardHistoryToggled" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="快速启动显示行数" Foreground="{ThemeResource EdgeTextBrush}" />
                    <TextBlock Text="控制首页快速启动区可见行数，超出后可上下滚动（1-4）"
                               FontSize="12" Foreground="{ThemeResource EdgeMutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <NumberBox x:Name="QuickLaunchVisibleRowsBox" Grid.Column="1"
                           Width="190" Height="36" VerticalAlignment="Center"
                           Minimum="1" Maximum="4" SmallChange="1" LargeChange="1"
                           SpinButtonPlacementMode="Inline"
                           ValueChanged="OnQuickLaunchVisibleRowsChanged" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="清除最近记录" Foreground="{ThemeResource EdgeTextBrush}" />
                    <TextBlock Text="删除已记录的最近窗口与最近使用"
                               FontSize="12" Foreground="{ThemeResource EdgeMutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="ClearRecentButton" Grid.Column="1" Content="清除"
                        Height="36" VerticalAlignment="Center"
                        Click="OnClearRecentClick" />
            </Grid>

            <!-- AI -->
            <TextBlock Text="AI / 智能体" FontSize="14" FontWeight="SemiBold"
                       Foreground="{ThemeResource EdgeMutedBrush}" Margin="0,4,0,0" />

            <InfoBar x:Name="AiStatusBar"
                     IsOpen="False"
                     IsClosable="True" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="启用智能体" Foreground="{ThemeResource EdgeTextBrush}" />
                    <TextBlock Text="启用后可在智能体页面使用对话、翻译和 Windows 配置助手"
                               FontSize="12" Foreground="{ThemeResource EdgeMutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch x:Name="AiEnabledSwitch" Grid.Column="1"
                              VerticalAlignment="Center"
                              Toggled="OnAiSettingChanged" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Base URL" Foreground="{ThemeResource EdgeTextBrush}" />
                    <TextBlock Text="OpenAI 兼容接口地址，例如 https://api.openai.com/v1"
                               FontSize="12" Foreground="{ThemeResource EdgeMutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <TextBox x:Name="AiBaseUrlBox" Grid.Column="1"
                         Width="260" Height="36" VerticalAlignment="Center"
                         LostFocus="OnAiTextSettingLostFocus" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="模型" Foreground="{ThemeResource EdgeTextBrush}" />
                    <TextBlock Text="模型名称，例如 gpt-4.1-mini 或兼容服务提供的模型 id"
                               FontSize="12" Foreground="{ThemeResource EdgeMutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <TextBox x:Name="AiModelBox" Grid.Column="1"
                         Width="260" Height="36" VerticalAlignment="Center"
                         LostFocus="OnAiTextSettingLostFocus" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="API Key" Foreground="{ThemeResource EdgeTextBrush}" />
                    <TextBlock x:Name="AiApiKeyHintText"
                               FontSize="12" Foreground="{ThemeResource EdgeMutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <PasswordBox x:Name="AiApiKeyBox" Grid.Column="1"
                             Width="260" Height="36" VerticalAlignment="Center"
                             PasswordChanged="OnAiApiKeyChanged" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="温度" Foreground="{ThemeResource EdgeTextBrush}" />
                    <TextBlock Text="控制回答发散程度，0 更稳定，2 更发散"
                               FontSize="12" Foreground="{ThemeResource EdgeMutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <NumberBox x:Name="AiTemperatureBox" Grid.Column="1"
                           Width="190" Height="36" VerticalAlignment="Center"
                           Minimum="0" Maximum="2" SmallChange="0.1" LargeChange="0.5"
                           SpinButtonPlacementMode="Inline"
                           ValueChanged="OnAiNumberSettingChanged" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="默认模式" Foreground="{ThemeResource EdgeTextBrush}" />
                    <TextBlock Text="新建智能体会话时默认使用的模式"
                               FontSize="12" Foreground="{ThemeResource EdgeMutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <ComboBox x:Name="AiDefaultModeBox" Grid.Column="1"
                          Width="190" Height="36" VerticalAlignment="Center"
                          SelectionChanged="OnAiSettingChanged">
                    <ComboBoxItem Content="对话" Tag="Chat" />
                    <ComboBoxItem Content="翻译" Tag="Translate" />
                    <ComboBoxItem Content="Windows 配置" Tag="WindowsConfig" />
                </ComboBox>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="动作模式" Foreground="{ThemeResource EdgeTextBrush}" />
                    <TextBlock Text="控制智能体是否能生成或执行工具调用"
                               FontSize="12" Foreground="{ThemeResource EdgeMutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <ComboBox x:Name="AiActionModeBox" Grid.Column="1"
                          Width="190" Height="36" VerticalAlignment="Center"
                          SelectionChanged="OnAiSettingChanged">
                    <ComboBoxItem Content="只给建议" Tag="SuggestOnly" />
                    <ComboBoxItem Content="确认后执行" Tag="ConfirmBeforeAction" />
                    <ComboBoxItem Content="白名单自动" Tag="AutoWithWhitelist" />
                </ComboBox>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="允许读取剪贴板历史" Foreground="{ThemeResource EdgeTextBrush}" />
                    <TextBlock Text="开启后智能体可调用剪贴板历史查询工具"
                               FontSize="12" Foreground="{ThemeResource EdgeMutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch x:Name="AiAllowClipboardToolsSwitch" Grid.Column="1"
                              VerticalAlignment="Center"
                              Toggled="OnAiSettingChanged" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="连接测试" Foreground="{ThemeResource EdgeTextBrush}" />
                    <TextBlock Text="使用当前配置向模型发送一次轻量测试请求"
                               FontSize="12" Foreground="{ThemeResource EdgeMutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="AiTestButton" Grid.Column="1" Content="测试"
                        Height="36" VerticalAlignment="Center"
                        Click="OnAiTestClick" />
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
