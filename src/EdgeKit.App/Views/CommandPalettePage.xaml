<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="EdgeKit.App.Views.CommandPalettePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    RequestedTheme="Dark"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="CommandGridViewItemStyle" TargetType="GridViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource EdgeAccentBrush}" />
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent" />
            <Setter Property="FocusVisualPrimaryThickness" Value="1" />
            <Setter Property="FocusVisualSecondaryThickness" Value="0" />
            <Setter Property="FocusVisualMargin" Value="2" />
        </Style>

        <DataTemplate x:Key="CommandItemTemplate">
            <Border Height="108" CornerRadius="8" Padding="10"
                    HorizontalAlignment="Stretch"
                    Background="{ThemeResource EdgePanelBrush}"
                    BorderBrush="{ThemeResource EdgeLineBrush}"
                    BorderThickness="1"
                    RightTapped="OnCommandItemRightTapped">
                <Grid RowSpacing="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Row 0：图标 + 标题 -->
                    <Grid Grid.Row="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8"
                                Background="{ThemeResource EdgeControlBrush}"
                                BorderBrush="{ThemeResource EdgeLineBrush}" BorderThickness="1">
                            <FontIcon FontSize="15"
                                      Foreground="{ThemeResource EdgeAccentBrush}"
                                      Glyph="{Binding Glyph}" />
                        </Border>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Title}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource EdgeTextBrush}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1" />
                    </Grid>

                    <!-- Row 1：描述 -->
                    <TextBlock Grid.Row="1"
                               Margin="0,5,0,0"
                               Text="{Binding Description}"
                               FontSize="11"
                               Foreground="{ThemeResource EdgeMutedBrush}"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="2" />

                    <!-- Row 2：分类标签，右对齐 -->
                    <Border Grid.Row="2" CornerRadius="5" Padding="5,1"
                            HorizontalAlignment="Right"
                            Background="{ThemeResource EdgeControlBrush}">
                        <TextBlock Text="{Binding Category}"
                                   FontSize="10"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource EdgeMutedBrush}" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24,16,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Text="命令面板"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource EdgeTextBrush}" />
                <TextBlock Text="系统命令、自定义命令"
                           FontSize="12"
                           Foreground="{ThemeResource EdgeMutedBrush}" />
            </StackPanel>

            <Button Grid.Column="1"
                    Width="40"
                    Height="36"
                    Padding="0"
                    Click="OnAddCustomCommandClick"
                    ToolTipService.ToolTip="添加自定义命令">
                <FontIcon FontSize="16" Glyph="&#xE710;" />
            </Button>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0"
                          HorizontalScrollMode="Auto"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollMode="Disabled"
                          VerticalScrollBarVisibility="Hidden">
                <ItemsControl x:Name="CategoryFilterBar">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Column="1"
                    Height="36"
                    CornerRadius="8"
                    Background="{ThemeResource EdgeControlBrush}"
                    BorderBrush="{ThemeResource EdgeLineBrush}"
                    BorderThickness="1">
                <Grid Padding="10,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" FontSize="16"
                              Glyph="&#xE721;"
                              Foreground="{ThemeResource EdgeMutedBrush}"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0" />
                    <TextBox x:Name="CommandSearchInput"
                             Grid.Column="1"
                             PlaceholderText="搜索命令"
                             BorderThickness="0"
                             Background="Transparent"
                             VerticalAlignment="Center"
                             TextChanged="OnCommandSearchTextChanged"
                             KeyDown="OnCommandSearchKeyDown">
                        <TextBox.Resources>
                            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                        </TextBox.Resources>
                    </TextBox>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" SizeChanged="OnCommandGridSizeChanged">
            <GridView x:Name="CommandCardsGrid"
                      Padding="0"
                      Margin="0,0,-12,0"
                      SelectionMode="Single"
                      IsItemClickEnabled="True"
                      ItemClick="OnCommandItemClick"
                      KeyDown="OnCommandGridKeyDown"
                      ItemTemplate="{StaticResource CommandItemTemplate}"
                      ItemContainerStyle="{StaticResource CommandGridViewItemStyle}">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:ItemsWrapGrid Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
            </GridView>

            <TextBlock x:Name="EmptyHint"
                       Text="没有找到命令"
                       FontSize="13"
                       Foreground="{ThemeResource EdgeMutedBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed" />
        </Grid>
    </Grid>
</Page>
