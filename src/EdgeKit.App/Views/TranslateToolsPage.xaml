<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="EdgeKit.App.Views.TranslateToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    RequestedTheme="Dark"
    mc:Ignorable="d">

    <Grid x:Name="PageRoot" Padding="24,16,24,16" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="翻译"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="{ThemeResource EdgeTextBrush}" />

        <!-- 语言选择 + 翻译按钮 -->
        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="源语言"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource EdgeMutedBrush}" />
            <ComboBox x:Name="SourceLanguageBox"
                      Grid.Column="1"
                      Height="36"
                      VerticalAlignment="Center" />

            <TextBlock Grid.Column="2"
                       Text="目标语言"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource EdgeMutedBrush}" />
            <ComboBox x:Name="TargetLanguageBox"
                      Grid.Column="3"
                      Height="36"
                      MaxWidth="200"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center" />

            <Button x:Name="TranslateButton"
                    Grid.Column="5"
                    Height="36"
                    Padding="16,0"
                    VerticalAlignment="Center"
                    Background="{ThemeResource EdgeAccentBrush}"
                    Foreground="White"
                    Click="OnTranslateClick">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon FontSize="14" Glyph="&#xE774;" VerticalAlignment="Center" />
                    <TextBlock Text="翻译" VerticalAlignment="Center" Margin="0,-2,0,0" />
                </StackPanel>
            </Button>

            <Button x:Name="ClearButton"
                    Grid.Column="6"
                    Height="36"
                    Padding="12,0"
                    VerticalAlignment="Center"
                    Background="{ThemeResource EdgeControlBrush}"
                    BorderBrush="{ThemeResource EdgeLineBrush}"
                    Click="OnClearClick"
                    ToolTipService.ToolTip="清空原文与结果">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon FontSize="14" Glyph="&#xE74D;" VerticalAlignment="Center" />
                    <TextBlock Text="清空" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- 原文输入 -->
        <Border Grid.Row="2"
                Height="120"
                CornerRadius="10"
                Background="{ThemeResource EdgeControlBrush}"
                BorderBrush="{ThemeResource EdgeLineBrush}"
                BorderThickness="1">
            <TextBox x:Name="SourceTextBox"
                     PlaceholderText="输入要翻译的文本..."
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     BorderThickness="0"
                     Background="Transparent"
                     Padding="12"
                     FontSize="14"
                     Foreground="{ThemeResource EdgeTextBrush}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </Border>

        <!-- 翻译结果：左右并排 -->
        <Grid Grid.Row="3" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 有道翻译 -->
            <Border Grid.Column="0"
                    CornerRadius="12"
                    Background="{ThemeResource EdgePanelBrush}"
                    BorderBrush="{ThemeResource EdgeLineBrush}"
                    BorderThickness="1">
                <Grid RowSpacing="10" Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Height="32" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Width="34"
                                    Height="22"
                                    CornerRadius="6"
                                    Background="{ThemeResource EdgeAccentSoftBrush}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="有道"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource EdgeAccentBrush}" />
                            </Border>
                            <TextBlock Text="有道翻译"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="0,-1,0,0"
                                       Foreground="{ThemeResource EdgeTextBrush}" />
                            <ProgressRing x:Name="YoudaoProgress"
                                          Width="14"
                                          Height="14"
                                          IsActive="False"
                                          Visibility="Collapsed"
                                          VerticalAlignment="Center" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                x:Name="CopyYoudaoButton"
                                Click="OnCopyYoudaoClick"
                                Width="32"
                                Height="32"
                                Padding="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                ToolTipService.ToolTip="复制有道翻译结果">
                            <FontIcon FontSize="14" Glyph="&#xE8C8;" VerticalAlignment="Center" Foreground="{ThemeResource EdgeMutedBrush}" />
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="YoudaoResultText"
                                   TextWrapping="Wrap"
                                   FontSize="14"
                                   Foreground="{ThemeResource EdgeTextBrush}" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 大模型翻译 -->
            <Border Grid.Column="1"
                    CornerRadius="12"
                    Background="{ThemeResource EdgePanelBrush}"
                    BorderBrush="{ThemeResource EdgeLineBrush}"
                    BorderThickness="1">
                <Grid RowSpacing="10" Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Height="32" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Width="34"
                                    Height="22"
                                    CornerRadius="6"
                                    Background="{ThemeResource EdgeAccentSoftBrush}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="AI"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource EdgeAccentBrush}" />
                            </Border>
                            <TextBlock Text="大模型翻译"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="0,-1,0,0"
                                       Foreground="{ThemeResource EdgeTextBrush}" />
                            <ProgressRing x:Name="LlmProgress"
                                          Width="14"
                                          Height="14"
                                          IsActive="False"
                                          Visibility="Collapsed"
                                          VerticalAlignment="Center" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                x:Name="CopyLlmButton"
                                Click="OnCopyLlmClick"
                                Width="32"
                                Height="32"
                                Padding="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                ToolTipService.ToolTip="复制大模型翻译结果">
                            <FontIcon FontSize="14" Glyph="&#xE8C8;" VerticalAlignment="Center" Foreground="{ThemeResource EdgeMutedBrush}" />
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="LlmResultText"
                                   TextWrapping="Wrap"
                                   FontSize="14"
                                   Foreground="{ThemeResource EdgeTextBrush}" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="CopyToast"
                Grid.RowSpan="4"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,0,8"
                Padding="12,8"
                CornerRadius="8"
                Background="{ThemeResource EdgePanelBrush}"
                BorderBrush="{ThemeResource EdgeLineBrush}"
                BorderThickness="1"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon x:Name="CopyToastIcon"
                          FontSize="14"
                          Glyph="&#xE73E;"
                          Foreground="{ThemeResource EdgeAccentBrush}" />
                <TextBlock x:Name="CopyToastText"
                           Text="已复制到剪贴板"
                           FontSize="13"
                           Foreground="{ThemeResource EdgeTextBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>