<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="EdgeKit.App.Views.StickyNotesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:EdgeKit.App.ViewModels"
    Background="Transparent"
    RequestedTheme="Dark"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="StickyNoteItemTemplate" x:DataType="vm:StickyNoteItemViewModel">
            <Border Style="{StaticResource EdgeCardBorderStyle}"
                    Margin="0,0,0,8"
                    Padding="12,10">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="34"
                            Height="34"
                            CornerRadius="{StaticResource EdgeRadiusMd}"
                            Background="{x:Bind ColorBrush, Mode=OneTime}"
                            BorderBrush="{ThemeResource EdgeLineBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE70B;"
                                  FontSize="15"
                                  Foreground="{ThemeResource EdgeTextBrush}" />
                    </Border>

                    <StackPanel Grid.Column="1"
                                Spacing="3"
                                VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind PreviewText, Mode=OneTime}"
                                   FontSize="14"
                                   Foreground="{ThemeResource EdgeTextBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border CornerRadius="{StaticResource EdgeRadiusXs}"
                                    Padding="6,1"
                                    Background="{ThemeResource EdgeControlBrush}">
                                <TextBlock Text="{x:Bind StatusLabel, Mode=OneTime}"
                                           FontSize="11"
                                           Foreground="{ThemeResource EdgeAccentBrush}" />
                            </Border>
                            <TextBlock Text="{x:Bind UpdatedText, Mode=OneTime}"
                                       FontSize="12"
                                       Foreground="{ThemeResource EdgeMutedBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center">
                        <Button x:Name="ToggleOpenButton"
                                Width="32"
                                Height="32"
                                MinWidth="0"
                                Padding="0"
                                Style="{StaticResource EdgeToolButtonStyle}"
                                Click="OnToggleOpenClick"
                                ToolTipService.ToolTip="{x:Bind OpenCloseLabel, Mode=OneTime}">
                            <FontIcon Glyph="{x:Bind OpenCloseGlyph, Mode=OneTime}"
                                      FontSize="14" />
                        </Button>

                        <Button Width="32"
                                Height="32"
                                MinWidth="0"
                                Padding="0"
                                Style="{StaticResource EdgeToolButtonStyle}"
                                BorderBrush="{ThemeResource EdgeDangerBrush}"
                                Foreground="{ThemeResource EdgeDangerBrush}"
                                Click="OnDeleteClick"
                                ToolTipService.ToolTip="删除">
                            <FontIcon Glyph="&#xE74D;"
                                      FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="24,16,24,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="便签"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource EdgeTextBrush}" />
                <TextBlock Text="独立桌面便签与快速记录"
                           FontSize="12"
                           Foreground="{ThemeResource EdgeMutedBrush}" />
            </StackPanel>

            <Button Grid.Column="1"
                     Style="{StaticResource EdgeToolButtonStyle}"
                     Height="36"
                     Click="OnCreateNewClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="新建便签" />
                </StackPanel>
            </Button>
        </Grid>

        <ListView x:Name="NotesList"
                  Grid.Row="1"
                  Padding="24,0,24,18"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  ItemClick="OnNoteItemClick"
                  ItemTemplate="{StaticResource StickyNoteItemTemplate}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="CornerRadius" Value="{StaticResource EdgeRadiusMd}" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <Border x:Name="EmptyHint"
                Grid.Row="1"
                Style="{StaticResource EdgeCardBorderStyle}"
                Width="260"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed">
            <StackPanel Spacing="8"
                        HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE70B;"
                          FontSize="22"
                          Foreground="{ThemeResource EdgeAccentBrush}" />
                <TextBlock Text="还没有便签"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource EdgeTextBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="点击右上角新建一个"
                           FontSize="12"
                           Foreground="{ThemeResource EdgeMutedBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
