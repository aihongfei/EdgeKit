<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="EdgeKit.App.Views.AgentChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    RequestedTheme="Dark"
    mc:Ignorable="d">

    <Grid Padding="16" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Text="智能体" FontSize="22" FontWeight="SemiBold"
                       Foreground="{ThemeResource EdgeTextBrush}" />

            <StackPanel Grid.Row="1" Spacing="8">
                <ComboBox x:Name="ModeBox" Height="34" SelectionChanged="OnModeChanged">
                    <ComboBoxItem Content="对话" Tag="Chat" />
                    <ComboBoxItem Content="翻译" Tag="Translate" />
                    <ComboBoxItem Content="Windows 配置" Tag="WindowsConfig" />
                </ComboBox>
                <Button Content="新建会话" Height="34" Click="OnNewConversationClick" />
            </StackPanel>

            <ListView x:Name="ConversationList"
                      Grid.Row="2"
                      SelectionChanged="OnConversationSelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="4">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                       Foreground="{ThemeResource EdgeTextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Detail}" FontSize="12"
                                       Foreground="{ThemeResource EdgeMutedBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Grid Grid.Column="1" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <InfoBar x:Name="StatusBar"
                     IsOpen="False"
                     IsClosable="True" />

            <ListView x:Name="MessageList" Grid.Row="1"
                      SelectionMode="None"
                      IsItemClickEnabled="False">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,10">
                            <Border Visibility="{Binding MessageVisibility}"
                                    HorizontalAlignment="{Binding BubbleAlignment}"
                                    MaxWidth="640"
                                    Background="{Binding BubbleBackground}"
                                    BorderBrush="{Binding BubbleBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding RoleText}" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource EdgeTextBrush}" />
                                        <TextBlock Text="{Binding TimeText}" FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource EdgeMutedBrush}" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal"
                                                Spacing="8"
                                                Visibility="{Binding LoadingVisibility}">
                                        <ProgressRing Width="18"
                                                      Height="18"
                                                      IsActive="True" />
                                        <TextBlock Text="正在思考..."
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource EdgeMutedBrush}" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding Content}"
                                               Visibility="{Binding ContentVisibility}"
                                               TextWrapping="Wrap"
                                               LineHeight="20"
                                               IsTextSelectionEnabled="True"
                                               Foreground="{ThemeResource EdgeTextBrush}" />
                                </StackPanel>
                            </Border>

                            <Border Visibility="{Binding ToolVisibility}"
                                    Background="{ThemeResource EdgeControlBrush}"
                                    BorderBrush="{ThemeResource EdgeLineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          Background="Transparent"
                                          CornerRadius="10"
                                          BorderThickness="0"
                                          Padding="10,6,6,6">
                                    <Expander.Header>
                                        <Grid HorizontalAlignment="Stretch" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding ToolTitle}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource EdgeTextBrush}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ToolStatusText}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource EdgeMutedBrush}" />
                                        </Grid>
                                    </Expander.Header>
                                    <StackPanel Padding="4,4,4,8" Spacing="10">
                                        <TextBlock Text="{Binding ToolSummary}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{ThemeResource EdgeMutedBrush}" />
                                        <TextBlock Text="{Binding ToolDetail}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   IsTextSelectionEnabled="True"
                                                   Foreground="{ThemeResource EdgeMutedBrush}" />
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    Spacing="8"
                                                    Visibility="{Binding ToolActionVisibility}">
                                            <Button Content="确认"
                                                    Style="{ThemeResource AccentButtonStyle}"
                                                    Tag="{Binding ToolCallId}"
                                                    Click="OnApproveToolClick" />
                                            <Button Content="拒绝"
                                                    Tag="{Binding ToolCallId}"
                                                    Click="OnRejectToolClick" />
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid Grid.Row="2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PromptBox"
                         MinHeight="42"
                         MaxHeight="160"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         PlaceholderText="输入消息，Enter 发送，Shift+Enter 换行" />
                <Button x:Name="SendButton"
                        Grid.Column="1"
                        Content="发送"
                        Width="82"
                        VerticalAlignment="Bottom"
                        Style="{ThemeResource AccentButtonStyle}"
                        Click="OnSendClick" />
            </Grid>
        </Grid>
    </Grid>
</Page>
