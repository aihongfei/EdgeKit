<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="EdgeKit.App.Views.AgentChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    RequestedTheme="Dark"
    mc:Ignorable="d">

    <Grid Padding="16" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="智能体" FontSize="22" FontWeight="SemiBold"
                       Foreground="{ThemeResource EdgeTextBrush}" />

            <StackPanel Grid.Row="1" Spacing="8">
                <ComboBox x:Name="ModeBox" Height="34" SelectionChanged="OnModeChanged">
                    <ComboBoxItem Content="对话" Tag="Chat" />
                    <ComboBoxItem Content="翻译" Tag="Translate" />
                    <ComboBoxItem Content="Windows 配置" Tag="WindowsConfig" />
                </ComboBox>
                <Button Content="新建会话" Height="34" Click="OnNewConversationClick" />
            </StackPanel>

            <ListView x:Name="ConversationList"
                      Grid.Row="2"
                      SelectionChanged="OnConversationSelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="4">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                       Foreground="{ThemeResource EdgeTextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Detail}" FontSize="12"
                                       Foreground="{ThemeResource EdgeMutedBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button x:Name="AgentSettingsButton"
                    Grid.Row="3"
                    Content="智能体设置"
                    Height="34"
                    Click="OnShowSettingsClick" />
        </Grid>

        <Grid x:Name="ChatPanel" Grid.Column="1" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <InfoBar x:Name="StatusBar"
                     IsOpen="False"
                     IsClosable="True" />

            <ListView x:Name="MessageList" Grid.Row="1"
                      SelectionMode="None"
                      IsItemClickEnabled="False">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,10">
                            <Border Visibility="{Binding MessageVisibility}"
                                    HorizontalAlignment="{Binding BubbleAlignment}"
                                    MaxWidth="640"
                                    Background="{Binding BubbleBackground}"
                                    BorderBrush="{Binding BubbleBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding RoleText}" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource EdgeTextBrush}" />
                                        <TextBlock Text="{Binding TimeText}" FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource EdgeMutedBrush}" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal"
                                                Spacing="8"
                                                Visibility="{Binding LoadingVisibility}">
                                        <ProgressRing Width="18"
                                                      Height="18"
                                                      IsActive="True" />
                                        <TextBlock Text="正在思考..."
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource EdgeMutedBrush}" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding Content}"
                                               Visibility="{Binding ContentVisibility}"
                                               TextWrapping="Wrap"
                                               LineHeight="20"
                                               IsTextSelectionEnabled="True"
                                               Foreground="{ThemeResource EdgeTextBrush}" />

                                    <Border Visibility="{Binding ActivityVisibility}"
                                            Background="{ThemeResource EdgeControlBrush}"
                                            BorderBrush="{ThemeResource EdgeLineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="8,6">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ProgressRing Width="14"
                                                          Height="14"
                                                          IsActive="True"
                                                          Visibility="{Binding ActivityProgressVisibility}" />
                                            <FontIcon Glyph="&#xE73E;"
                                                      FontSize="12"
                                                      Visibility="{Binding ActivityIconVisibility}"
                                                      Foreground="{ThemeResource EdgeMutedBrush}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ActivityText}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Foreground="{ThemeResource EdgeMutedBrush}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Visibility="{Binding ToolVisibility}"
                                    Background="{ThemeResource EdgeControlBrush}"
                                    BorderBrush="{ThemeResource EdgeLineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          Background="Transparent"
                                          CornerRadius="10"
                                          BorderThickness="0"
                                          Padding="10,6,6,6">
                                    <Expander.Header>
                                        <Grid HorizontalAlignment="Stretch" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding ToolTitle}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource EdgeTextBrush}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ToolStatusText}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource EdgeMutedBrush}" />
                                            <StackPanel Grid.Column="2"
                                                        Orientation="Horizontal"
                                                        Spacing="6"
                                                        Visibility="{Binding ToolActionVisibility}">
                                                <Button Content="确认"
                                                        MinWidth="56"
                                                        Padding="10,4"
                                                        Style="{ThemeResource AccentButtonStyle}"
                                                        Tag="{Binding ToolCallId}"
                                                        PointerPressed="OnToolActionPointerPressed"
                                                        Click="OnApproveToolClick" />
                                                <Button Content="拒绝"
                                                        MinWidth="56"
                                                        Padding="10,4"
                                                        Tag="{Binding ToolCallId}"
                                                        PointerPressed="OnToolActionPointerPressed"
                                                        Click="OnRejectToolClick" />
                                            </StackPanel>
                                        </Grid>
                                    </Expander.Header>
                                    <StackPanel Padding="4,4,4,8" Spacing="10">
                                        <TextBlock Text="{Binding ToolSummary}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{ThemeResource EdgeMutedBrush}" />
                                        <TextBlock Text="{Binding ToolDetail}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   IsTextSelectionEnabled="True"
                                                   Foreground="{ThemeResource EdgeMutedBrush}" />
                                    </StackPanel>
                                </Expander>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid Grid.Row="2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PromptBox"
                         MinHeight="42"
                         MaxHeight="160"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         PlaceholderText="输入消息，Enter 发送，Shift+Enter 换行" />
                <Button x:Name="SendButton"
                        Grid.Column="1"
                        Content="发送"
                        Width="82"
                        VerticalAlignment="Bottom"
                        Style="{ThemeResource AccentButtonStyle}"
                        Click="OnSendClick" />
            </Grid>
        </Grid>

        <ScrollViewer x:Name="SettingsPanel"
                      Grid.Column="1"
                      Visibility="Collapsed">
            <StackPanel Spacing="14" Padding="0,0,4,0">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="智能体设置"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource EdgeTextBrush}" />
                    <Button Grid.Column="1"
                            Content="返回对话"
                            Height="34"
                            Click="OnShowChatClick" />
                </Grid>

                <InfoBar x:Name="AgentSettingsStatusBar"
                         IsOpen="False"
                         IsClosable="True" />

                <TextBlock Text="模型" FontSize="14" FontWeight="SemiBold"
                           Foreground="{ThemeResource EdgeMutedBrush}" />

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="启用智能体" Foreground="{ThemeResource EdgeTextBrush}" />
                        <TextBlock Text="开启后可使用对话、翻译和工具调用"
                                   FontSize="12"
                                   Foreground="{ThemeResource EdgeMutedBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch x:Name="AiEnabledSwitch"
                                  Grid.Column="1"
                                  Toggled="OnAgentSettingChanged" />
                </Grid>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Base URL" Foreground="{ThemeResource EdgeTextBrush}" />
                        <TextBlock Text="OpenAI 兼容接口地址"
                                   FontSize="12"
                                   Foreground="{ThemeResource EdgeMutedBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBox x:Name="AiBaseUrlBox"
                             Grid.Column="1"
                             Height="36"
                             LostFocus="OnAgentTextSettingLostFocus" />
                </Grid>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="模型" Foreground="{ThemeResource EdgeTextBrush}" />
                        <TextBlock Text="例如 gpt-4.1-mini 或兼容服务提供的模型 id"
                                   FontSize="12"
                                   Foreground="{ThemeResource EdgeMutedBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBox x:Name="AiModelBox"
                             Grid.Column="1"
                             Height="36"
                             LostFocus="OnAgentTextSettingLostFocus" />
                </Grid>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="API Key" Foreground="{ThemeResource EdgeTextBrush}" />
                        <TextBlock x:Name="AiApiKeyHintText"
                                   FontSize="12"
                                   Foreground="{ThemeResource EdgeMutedBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <PasswordBox x:Name="AiApiKeyBox"
                                 Grid.Column="1"
                                 Height="36"
                                 PasswordChanged="OnAgentApiKeyChanged" />
                </Grid>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="190" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="温度" Foreground="{ThemeResource EdgeTextBrush}" />
                        <TextBlock Text="0 更稳定，2 更发散"
                                   FontSize="12"
                                   Foreground="{ThemeResource EdgeMutedBrush}" />
                    </StackPanel>
                    <NumberBox x:Name="AiTemperatureBox"
                               Grid.Column="1"
                               Height="36"
                               Minimum="0"
                               Maximum="2"
                               SmallChange="0.1"
                               LargeChange="0.5"
                               SpinButtonPlacementMode="Inline"
                               ValueChanged="OnAgentNumberSettingChanged" />
                </Grid>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="190" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="默认模式" Foreground="{ThemeResource EdgeTextBrush}" />
                        <TextBlock Text="新建会话时默认使用的模式"
                                   FontSize="12"
                                   Foreground="{ThemeResource EdgeMutedBrush}" />
                    </StackPanel>
                    <ComboBox x:Name="AiDefaultModeBox"
                              Grid.Column="1"
                              Height="36"
                              SelectionChanged="OnAgentSelectionSettingChanged">
                        <ComboBoxItem Content="对话" Tag="Chat" />
                        <ComboBoxItem Content="翻译" Tag="Translate" />
                        <ComboBoxItem Content="Windows 配置" Tag="WindowsConfig" />
                    </ComboBox>
                </Grid>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="190" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="动作模式" Foreground="{ThemeResource EdgeTextBrush}" />
                        <TextBlock Text="控制工具是否自动执行"
                                   FontSize="12"
                                   Foreground="{ThemeResource EdgeMutedBrush}" />
                    </StackPanel>
                    <ComboBox x:Name="AiActionModeBox"
                              Grid.Column="1"
                              Height="36"
                              SelectionChanged="OnAgentSelectionSettingChanged">
                        <ComboBoxItem Content="只给建议" Tag="SuggestOnly" />
                        <ComboBoxItem Content="确认后执行" Tag="ConfirmBeforeAction" />
                        <ComboBoxItem Content="白名单自动" Tag="AutoWithWhitelist" />
                    </ComboBox>
                </Grid>

                <TextBlock Text="工具" FontSize="14" FontWeight="SemiBold"
                           Foreground="{ThemeResource EdgeMutedBrush}" />

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="允许读取剪贴板历史" Foreground="{ThemeResource EdgeTextBrush}" />
                    <ToggleSwitch x:Name="AiAllowClipboardToolsSwitch"
                                  Grid.Column="1"
                                  Toggled="OnAgentSettingChanged" />
                </Grid>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="启用文件工具" Foreground="{ThemeResource EdgeTextBrush}" />
                    <ToggleSwitch x:Name="AiEnableFileToolsSwitch"
                                  Grid.Column="1"
                                  Toggled="OnAgentSettingChanged" />
                </Grid>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="启用 Shell 工具" Foreground="{ThemeResource EdgeTextBrush}" />
                    <ToggleSwitch x:Name="AiEnableShellToolsSwitch"
                                  Grid.Column="1"
                                  Toggled="OnAgentSettingChanged" />
                </Grid>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="启用 Web 工具" Foreground="{ThemeResource EdgeTextBrush}" />
                    <ToggleSwitch x:Name="AiEnableWebToolsSwitch"
                                  Grid.Column="1"
                                  Toggled="OnAgentSettingChanged" />
                </Grid>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="启用 MCP 配置" Foreground="{ThemeResource EdgeTextBrush}" />
                    <ToggleSwitch x:Name="AiEnableMcpToolsSwitch"
                                  Grid.Column="1"
                                  Toggled="OnAgentSettingChanged" />
                </Grid>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="190" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Web Search Provider" Foreground="{ThemeResource EdgeTextBrush}" />
                    <ComboBox x:Name="AiSearchProviderBox"
                              Grid.Column="1"
                              Height="36"
                              SelectionChanged="OnAgentSelectionSettingChanged">
                        <ComboBoxItem Content="Brave" Tag="Brave" />
                        <ComboBoxItem Content="Tavily" Tag="Tavily" />
                    </ComboBox>
                </Grid>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Search API Key" Foreground="{ThemeResource EdgeTextBrush}" />
                        <TextBlock x:Name="AiSearchApiKeyHintText"
                                   FontSize="12"
                                   Foreground="{ThemeResource EdgeMutedBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <PasswordBox x:Name="AiSearchApiKeyBox"
                                 Grid.Column="1"
                                 Height="36"
                                 PasswordChanged="OnAgentSearchApiKeyChanged" />
                </Grid>

                <TextBox x:Name="AiTrustedDirectoriesBox"
                         Header="可信目录白名单"
                         PlaceholderText="每行一个目录。写文件/替换文件命中这些目录时可自动执行。"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="76"
                         LostFocus="OnAgentTextSettingLostFocus" />

                <TextBox x:Name="AiShellCommandWhitelistBox"
                         Header="命令白名单"
                         PlaceholderText="每行一个命令前缀。例如: dotnet test"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="76"
                         LostFocus="OnAgentTextSettingLostFocus" />

                <TextBox x:Name="AiMcpServersJsonBox"
                         Header="MCP Servers JSON"
                         PlaceholderText="填写 MCP servers JSON 配置"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="96"
                         LostFocus="OnAgentTextSettingLostFocus" />

                <Button x:Name="AiTestButton"
                        Content="连接测试"
                        Width="110"
                        Height="36"
                        HorizontalAlignment="Right"
                        Click="OnAgentTestClick" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
