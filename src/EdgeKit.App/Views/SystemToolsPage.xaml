<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="EdgeKit.App.Views.SystemToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:diag="using:EdgeKit.Services.Diagnostics"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    RequestedTheme="Dark"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="{ThemeResource EdgePanelBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource EdgeLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="ToolTabButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="MinWidth" Value="82" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Background" Value="{ThemeResource EdgeControlBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource EdgeLineBrush}" />
        </Style>

        <Style x:Key="SmallIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <DataTemplate x:Key="NetworkAdapterTemplate" x:DataType="diag:NetworkAdapterInfo">
            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,10">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="8"
                                Background="{ThemeResource EdgeAccentSoftBrush}">
                            <FontIcon FontSize="16" Glyph="&#xE968;"
                                      Foreground="{ThemeResource EdgeAccentBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="1">
                            <TextBlock Text="{Binding Name}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{ThemeResource EdgeTextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding StatusText}"
                                       FontSize="11"
                                       Foreground="{ThemeResource EdgeMutedBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Style="{StaticResource SmallIconButtonStyle}"
                                Tag="{Binding}"
                                Click="OnCopyAdapterClick"
                                ToolTipService.ToolTip="复制此网卡信息">
                            <FontIcon FontSize="13" Glyph="&#xE8C8;" />
                        </Button>
                    </Grid>

                    <TextBlock Grid.Row="1" Text="{Binding Description}"
                               FontSize="11"
                               Foreground="{ThemeResource EdgeMutedBrush}"
                               TextTrimming="CharacterEllipsis" />

                    <Grid Grid.Row="2" RowSpacing="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding Ipv4Line}" FontSize="12"
                                   Foreground="{ThemeResource EdgeTextBrush}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Text="{Binding Ipv6Line}" FontSize="12"
                                   Foreground="{ThemeResource EdgeTextBrush}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="2" Text="{Binding GatewayLine}" FontSize="12"
                                   Foreground="{ThemeResource EdgeTextBrush}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="3" Text="{Binding DnsLine}" FontSize="12"
                                   Foreground="{ThemeResource EdgeTextBrush}" TextWrapping="Wrap" />
                    </Grid>

                    <Grid Grid.Row="3" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="复制 IP" Tag="{Binding Ipv4Text}" Click="OnCopyTaggedTextClick" />
                        <Button Grid.Column="1" Content="复制网关" Tag="{Binding GatewayText}" Click="OnCopyTaggedTextClick" />
                        <Button Grid.Column="2" Content="复制 DNS" Tag="{Binding DnsText}" Click="OnCopyTaggedTextClick" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="DriveTemplate" x:DataType="diag:DriveSnapshot">
            <Border CornerRadius="7" Padding="9"
                    Background="{ThemeResource EdgeControlBrush}"
                    BorderBrush="{ThemeResource EdgeLineBrush}" BorderThickness="1"
                    Margin="0,0,8,8">
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Name}"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{ThemeResource EdgeTextBrush}" />
                    <TextBlock Text="{Binding FreeText}"
                               FontSize="11" Foreground="{ThemeResource EdgeMutedBrush}" />
                    <TextBlock Text="{Binding TotalText}"
                               FontSize="11" Foreground="{ThemeResource EdgeMutedBrush}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PortEntryTemplate" x:DataType="diag:PortEntry">
            <Grid ColumnSpacing="8" Padding="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border CornerRadius="5" Padding="5,1"
                        Background="{ThemeResource EdgeAccentSoftBrush}"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Protocol}"
                               FontSize="10"
                               Foreground="{ThemeResource EdgeAccentBrush}" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock Text="{Binding EndpointTitle}"
                               FontSize="12"
                               Foreground="{ThemeResource EdgeTextBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}"
                               FontSize="11"
                               Foreground="{ThemeResource EdgeMutedBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="2"
                        Style="{StaticResource SmallIconButtonStyle}"
                        Tag="{Binding}"
                        Click="OnCopyPortClick"
                        ToolTipService.ToolTip="复制端口信息">
                    <FontIcon FontSize="13" Glyph="&#xE8C8;" />
                </Button>
                <Button Grid.Column="3"
                        Style="{StaticResource SmallIconButtonStyle}"
                        Tag="{Binding}"
                        Click="OnOpenPortProcessFolderClick"
                        ToolTipService.ToolTip="打开进程目录">
                    <FontIcon FontSize="13" Glyph="&#xE8B7;" />
                </Button>
                <Button Grid.Column="4"
                        Style="{StaticResource SmallIconButtonStyle}"
                        Tag="{Binding}"
                        Click="OnOpenPortLocalhostClick"
                        ToolTipService.ToolTip="打开 localhost">
                    <FontIcon FontSize="13" Glyph="&#xE774;" />
                </Button>
                <Button Grid.Column="5"
                        Content="结束"
                        MinWidth="54"
                        Padding="8,3"
                        Tag="{Binding}"
                        Click="OnKillPortClick"
                        ToolTipService.ToolTip="结束占用该端口的进程" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="PortGroupTemplate" x:DataType="diag:PortProcessGroup">
            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,8">
                <StackPanel Spacing="4">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Title}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource EdgeTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding Summary}"
                                   FontSize="11"
                                   Foreground="{ThemeResource EdgeMutedBrush}" />
                    </Grid>
                    <TextBlock Text="{Binding PortsText}"
                               FontSize="12"
                               Foreground="{ThemeResource EdgeMutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="EnvironmentVariableTemplate" x:DataType="diag:EnvironmentVariableEntry">
            <Grid ColumnSpacing="8" Padding="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border CornerRadius="5" Padding="5,1"
                        Background="{ThemeResource EdgeAccentSoftBrush}"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TargetText}"
                               FontSize="10"
                               Foreground="{ThemeResource EdgeAccentBrush}" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock Text="{Binding Name}"
                               FontSize="12"
                               Foreground="{ThemeResource EdgeTextBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ValuePreview}"
                               FontSize="11"
                               Foreground="{ThemeResource EdgeMutedBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="EnvironmentPathItemTemplate" x:DataType="diag:EnvironmentPathItem">
            <Grid ColumnSpacing="8" Padding="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding IndexText}"
                           FontSize="11"
                           Foreground="{ThemeResource EdgeMutedBrush}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding DisplayValue}"
                           FontSize="12"
                           Foreground="{ThemeResource EdgeTextBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2"
                           Text="{Binding IssueText}"
                           FontSize="11"
                           Foreground="{ThemeResource EdgeMutedBrush}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ManagedWindowTemplate" x:DataType="diag:ManagedWindowEntry">
            <StackPanel Spacing="2" Padding="0,6">
                <TextBlock Text="{Binding Title}"
                           FontSize="12"
                           Foreground="{ThemeResource EdgeTextBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Detail}"
                           FontSize="11"
                           Foreground="{ThemeResource EdgeMutedBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding StateText}"
                           FontSize="11"
                           Foreground="{ThemeResource EdgeMutedBrush}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="FileLockEntryTemplate" x:DataType="diag:FileLockEntry">
            <Grid ColumnSpacing="8" Padding="0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                          Checked="OnFileLockSelectionChanged"
                          Unchecked="OnFileLockSelectionChanged"
                          VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding Title}"
                               FontSize="12"
                               Foreground="{ThemeResource EdgeTextBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding FilePath}"
                               FontSize="11"
                               Foreground="{ThemeResource EdgeMutedBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}"
                               FontSize="11"
                               Foreground="{ThemeResource EdgeMutedBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="2"
                        Style="{StaticResource SmallIconButtonStyle}"
                        Tag="{Binding}"
                        Click="OnCopyFileLockEntryClick"
                        ToolTipService.ToolTip="复制占用信息">
                    <FontIcon FontSize="13" Glyph="&#xE8C8;" />
                </Button>
                <Button Grid.Column="3"
                        Style="{StaticResource SmallIconButtonStyle}"
                        Tag="{Binding}"
                        Click="OnOpenFileLockProcessFolderClick"
                        ToolTipService.ToolTip="打开进程目录">
                    <FontIcon FontSize="13" Glyph="&#xE8B7;" />
                </Button>
            </Grid>
        </DataTemplate>

    </Page.Resources>

    <Grid x:Name="PageRoot" Padding="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Text="系统工具"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource EdgeTextBrush}" />
                <TextBlock x:Name="PageSubtitle"
                           Text="网络诊断、端口占用、Hosts、环境变量、窗口管理、系统信息"
                           FontSize="12"
                           Foreground="{ThemeResource EdgeMutedBrush}" />
            </StackPanel>

            <Button Grid.Column="1"
                    Width="40"
                    Height="36"
                    Padding="0"
                    Click="OnRefreshClick"
                    ToolTipService.ToolTip="刷新当前工具">
                <FontIcon FontSize="16" Glyph="&#xE72C;" />
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="NetworkTabButton" Tag="network" Content="网络诊断" Click="OnTabClick" Style="{StaticResource ToolTabButtonStyle}" />
                <Button x:Name="PortsTabButton" Tag="ports" Content="端口占用" Click="OnTabClick" Style="{StaticResource ToolTabButtonStyle}" />
                <Button x:Name="HostsTabButton" Tag="hosts" Content="Hosts" Click="OnTabClick" Style="{StaticResource ToolTabButtonStyle}" />
                <Button x:Name="EnvironmentTabButton" Tag="env" Content="环境变量" Click="OnTabClick" Style="{StaticResource ToolTabButtonStyle}" />
                <Button x:Name="WindowTabButton" Tag="windows" Content="窗口管理" Click="OnTabClick" Style="{StaticResource ToolTabButtonStyle}" />
                <Button x:Name="FileLockTabButton" Tag="filelock" Content="文件锁定" Click="OnTabClick" Style="{StaticResource ToolTabButtonStyle}" />
                <Button x:Name="SystemTabButton" Tag="system" Content="系统信息" Click="OnTabClick" Style="{StaticResource ToolTabButtonStyle}" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2">
            <ScrollViewer x:Name="NetworkPanel" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12" Padding="0,0,8,0">
                    <Border Style="{StaticResource SectionCardStyle}">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="NetworkSummaryText"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource EdgeTextBrush}" />
                            <TextBlock Grid.Row="1"
                                       x:Name="PublicIpText"
                                       FontSize="12"
                                       Foreground="{ThemeResource EdgeMutedBrush}" />
                            <TextBlock Grid.Row="2"
                                       x:Name="ProxySummaryText"
                                       FontSize="12"
                                       Foreground="{ThemeResource EdgeMutedBrush}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SectionCardStyle}">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PingHostInput" PlaceholderText="Ping 主机" Text="8.8.8.8" MinWidth="0" />
                                <Button Grid.Column="1" Content="Ping" Click="OnPingClick" />
                                <Button Grid.Column="2" Content="复制" Click="OnCopyPingResultClick" />
                            </Grid>
                            <TextBlock x:Name="PingStatusText" Grid.Row="1" FontSize="12"
                                       Foreground="{ThemeResource EdgeMutedBrush}" TextWrapping="Wrap" />

                            <Grid Grid.Row="2" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="DnsHostInput" PlaceholderText="DNS 解析主机" Text="www.microsoft.com" MinWidth="0" />
                                <Button Grid.Column="1" Content="解析" Click="OnDnsProbeClick" />
                                <Button Grid.Column="2" Content="复制" Click="OnCopyDnsResultClick" />
                            </Grid>
                            <TextBlock x:Name="DnsStatusText" Grid.Row="3" FontSize="12"
                                       Foreground="{ThemeResource EdgeMutedBrush}" TextWrapping="Wrap" />

                            <Grid Grid.Row="4" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TcpHostInput" PlaceholderText="TCP 主机" Text="www.microsoft.com" MinWidth="0" />
                                <TextBox x:Name="TcpPortInput" Grid.Column="1" PlaceholderText="端口" Text="443" />
                                <Button Grid.Column="2" Content="连接" Click="OnTcpProbeClick" />
                                <Button Grid.Column="3" Content="复制" Click="OnCopyTcpResultClick" />
                            </Grid>
                            <TextBlock x:Name="TcpStatusText" Grid.Row="5" FontSize="12"
                                       Foreground="{ThemeResource EdgeMutedBrush}" TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="刷新网络信息" Click="OnRefreshNetworkClick" />
                        <Button Grid.Column="1" Content="刷新公网 IP" Click="OnRefreshPublicIpClick" />
                        <Button Grid.Column="2" Content="复制网络" Click="OnCopyNetworkClick" />
                    </Grid>

                    <ItemsControl x:Name="NetworkAdaptersList"
                                  ItemTemplate="{StaticResource NetworkAdapterTemplate}" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="PortsPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Spacing="12" Padding="0,0,8,0">
                    <Border Style="{StaticResource SectionCardStyle}">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBox x:Name="PortSearchInput"
                                     PlaceholderText="搜索端口 / PID / 进程名 / 路径"
                                     TextChanged="OnPortSearchTextChanged" />
                            <Grid Grid.Row="1" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="104" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="PortProtocolFilter" SelectedIndex="0" SelectionChanged="OnPortComboFilterChanged">
                                    <ComboBoxItem Content="全部" />
                                    <ComboBoxItem Content="TCP" />
                                    <ComboBoxItem Content="UDP" />
                                </ComboBox>
                                <ComboBox x:Name="PortStateFilter" Grid.Column="1" SelectedIndex="0" SelectionChanged="OnPortComboFilterChanged">
                                    <ComboBoxItem Content="全部" />
                                    <ComboBoxItem Content="监听" />
                                    <ComboBoxItem Content="已建立" />
                                    <ComboBoxItem Content="其他" />
                                </ComboBox>
                                <CheckBox x:Name="GroupPortsCheckBox" Grid.Column="2"
                                          Content="按进程分组"
                                          VerticalAlignment="Center"
                                          Checked="OnPortFilterChanged"
                                          Unchecked="OnPortFilterChanged" />
                                <Button Grid.Column="3" Content="复制列表" Click="OnCopyPortsClick" />
                            </Grid>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="PortHeaderText"
                               Text="端口占用"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource EdgeTextBrush}" />
                    <ListView x:Name="PortsList"
                              ItemTemplate="{StaticResource PortEntryTemplate}"
                              SelectionMode="None" />
                    <ListView x:Name="PortGroupsList"
                              ItemTemplate="{StaticResource PortGroupTemplate}"
                              SelectionMode="None"
                              Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="HostsPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Spacing="12" Padding="0,0,8,0">
                    <Border Style="{StaticResource SectionCardStyle}">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="HostsSummaryText"
                                       Text="Hosts"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource EdgeTextBrush}" />
                            <TextBlock Grid.Row="1"
                                       x:Name="HostsPathText"
                                       FontSize="11"
                                       Foreground="{ThemeResource EdgeMutedBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <Grid Grid.Row="2" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Content="保存" Click="OnSaveHostsClick" />
                                <Button Grid.Column="1" Content="恢复备份" Click="OnRestoreHostsBackupClick" />
                                <Button Grid.Column="2" Content="刷新 DNS" Click="OnFlushDnsClick" />
                                <Button Grid.Column="3" Content="复制内容" Click="OnCopyHostsContentClick" />
                            </Grid>
                        </Grid>
                    </Border>

                    <TextBox x:Name="HostsEditor"
                             AcceptsReturn="True"
                             FontFamily="Consolas"
                             MinHeight="420"
                             TextWrapping="NoWrap"
                             TextChanged="OnHostsEditorTextChanged" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="EnvironmentPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Spacing="12" Padding="0,0,8,0">
                    <Border Style="{StaticResource SectionCardStyle}">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="EnvironmentSummaryText"
                                       Text="环境变量"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource EdgeTextBrush}" />
                            <Grid Grid.Row="1" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="118" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="EnvironmentSearchInput"
                                         PlaceholderText="搜索变量名 / 值"
                                         TextChanged="OnEnvironmentFilterChanged" />
                                <ComboBox x:Name="EnvironmentScopeFilter"
                                          Grid.Column="1"
                                          SelectedIndex="0"
                                          SelectionChanged="OnEnvironmentScopeChanged">
                                    <ComboBoxItem Content="全部" />
                                    <ComboBoxItem Content="用户变量" />
                                    <ComboBoxItem Content="系统变量" />
                                </ComboBox>
                                <Button Grid.Column="2" Content="新增" Click="OnNewEnvironmentVariableClick" />
                                <Button Grid.Column="3" Content="复制列表" Click="OnCopyEnvironmentListClick" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="1.25*" />
                        </Grid.ColumnDefinitions>

                        <ListView x:Name="EnvironmentVariablesList"
                                  ItemTemplate="{StaticResource EnvironmentVariableTemplate}"
                                  SelectionMode="Single"
                                  SelectionChanged="OnEnvironmentVariableSelectionChanged"
                                  MaxHeight="520" />

                        <StackPanel Grid.Column="1" Spacing="12">
                            <Border Style="{StaticResource SectionCardStyle}">
                                <Grid RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="EnvironmentEditorHeaderText"
                                               Text="选择或新增变量"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource EdgeTextBrush}" />
                                    <Grid Grid.Row="1" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="118" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="EnvironmentNameInput"
                                                 PlaceholderText="变量名"
                                                 TextChanged="OnEnvironmentNameChanged" />
                                        <ComboBox x:Name="EnvironmentTargetInput"
                                                  Grid.Column="1"
                                                  SelectedIndex="0">
                                            <ComboBoxItem Content="用户变量" />
                                            <ComboBoxItem Content="系统变量" />
                                        </ComboBox>
                                    </Grid>
                                    <TextBox x:Name="EnvironmentValueInput"
                                             Grid.Row="2"
                                             AcceptsReturn="True"
                                             Height="130"
                                             TextWrapping="NoWrap"
                                             TextChanged="OnEnvironmentValueChanged" />
                                    <Grid Grid.Row="3" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="保存后新进程生效，已运行进程可能需重启"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource EdgeMutedBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="1" Content="保存" Click="OnSaveEnvironmentVariableClick" />
                                        <Button Grid.Column="2" Content="删除" Click="OnDeleteEnvironmentVariableClick" />
                                        <Button Grid.Column="3" Content="复制" Click="OnCopyEnvironmentVariableClick" />
                                    </Grid>
                                    <TextBlock x:Name="EnvironmentEditorStatusText"
                                               Grid.Row="4"
                                               FontSize="11"
                                               Foreground="{ThemeResource EdgeMutedBrush}"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </Border>

                            <Border x:Name="EnvironmentPathPanel"
                                    Style="{StaticResource SectionCardStyle}"
                                    Visibility="Collapsed">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Path 列表编辑"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource EdgeTextBrush}" />
                                    <ListView x:Name="EnvironmentPathItemsList"
                                              ItemTemplate="{StaticResource EnvironmentPathItemTemplate}"
                                              SelectionMode="Single"
                                              MaxHeight="220" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="EnvironmentPathNewItemInput"
                                                 PlaceholderText="新增路径项" />
                                        <Button Grid.Column="1" Content="添加" Click="OnAddEnvironmentPathItemClick" />
                                        <Button Grid.Column="2" Content="删除项" Click="OnRemoveEnvironmentPathItemClick" />
                                        <Button Grid.Column="3" Content="去重" Click="OnDedupeEnvironmentPathClick" />
                                    </Grid>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="EnvironmentPathIssuesText"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource EdgeMutedBrush}"
                                                   TextWrapping="Wrap" />
                                        <Button Grid.Column="1" Content="上移" Click="OnMoveEnvironmentPathItemUpClick" />
                                        <Button Grid.Column="2" Content="下移" Click="OnMoveEnvironmentPathItemDownClick" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="WindowPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Spacing="12" Padding="0,0,8,0">
                    <Border Style="{StaticResource SectionCardStyle}">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="WindowSummaryText"
                                       Text="窗口管理"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource EdgeTextBrush}" />
                            <Grid Grid.Row="1" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="WindowSearchInput"
                                         PlaceholderText="搜索窗口 / 进程 / PID"
                                         TextChanged="OnWindowSearchChanged" />
                                <Button Grid.Column="1" Content="复制信息" Click="OnCopyWindowInfoClick" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="1.25*" />
                        </Grid.ColumnDefinitions>
                        <ListView x:Name="WindowsList"
                                  ItemTemplate="{StaticResource ManagedWindowTemplate}"
                                  SelectionMode="Single"
                                  SelectionChanged="OnWindowSelectionChanged"
                                  MaxHeight="520" />

                        <Border Grid.Column="1" Style="{StaticResource SectionCardStyle}">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="WindowTitleText"
                                           Text="选择窗口"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource EdgeTextBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="WindowProcessText"
                                           Grid.Row="1"
                                           FontSize="12"
                                           Foreground="{ThemeResource EdgeTextBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="WindowPathText"
                                           Grid.Row="2"
                                           FontSize="11"
                                           Foreground="{ThemeResource EdgeMutedBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="WindowStateText"
                                           Grid.Row="3"
                                           FontSize="12"
                                           Foreground="{ThemeResource EdgeMutedBrush}"
                                           TextWrapping="Wrap" />
                                <Grid Grid.Row="4" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="透明度"
                                               FontSize="12"
                                               Foreground="{ThemeResource EdgeTextBrush}"
                                               VerticalAlignment="Center" />
                                    <Slider x:Name="WindowOpacitySlider"
                                            Grid.Column="1"
                                            Minimum="35"
                                            Maximum="100"
                                            StepFrequency="5"
                                            ValueChanged="OnWindowOpacityChanged" />
                                    <TextBlock x:Name="WindowOpacityText"
                                               Grid.Column="2"
                                               FontSize="12"
                                               Foreground="{ThemeResource EdgeMutedBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <Grid Grid.Row="5" RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Content="置顶" Click="OnSetWindowTopMostClick" />
                                        <Button Grid.Column="1" Content="取消置顶" Click="OnUnsetWindowTopMostClick" />
                                        <Button Grid.Column="2" Content="还原" Click="OnRestoreWindowClick" />
                                    </Grid>
                                    <Grid Grid.Row="1" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Content="激活" Click="OnActivateWindowClick" />
                                        <Button Grid.Column="1" Content="打开目录" Click="OnOpenWindowProcessDirectoryClick" />
                                        <Button Grid.Column="2" Content="刷新列表" Click="OnRefreshWindowsClick" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="FileLockPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Spacing="12" Padding="0,0,8,0">
                    <Border Style="{StaticResource SectionCardStyle}">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="FileLockSummaryText"
                                       Text="输入文件或文件夹路径后开始检测"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource EdgeTextBrush}"
                                       TextWrapping="Wrap" />
                            <Grid Grid.Row="1" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="FileLockPathInput"
                                         PlaceholderText="文件或文件夹路径"
                                         MinWidth="0" />
                                <Button Grid.Column="1" Content="选文件" Click="OnPickFileLockFileClick" />
                                <Button Grid.Column="2" Content="选文件夹" Click="OnPickFileLockFolderClick" />
                                <Button Grid.Column="3" Content="检测" Click="OnScanFileLocksClick" />
                            </Grid>
                            <TextBlock x:Name="FileLockStatusText"
                                       Grid.Row="2"
                                       FontSize="11"
                                       Foreground="{ThemeResource EdgeMutedBrush}"
                                       TextWrapping="Wrap" />
                            <Grid Grid.Row="3" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <CheckBox x:Name="SelectAllFileLocksCheckBox"
                                              Content="全选"
                                              Checked="OnSelectAllFileLocksChanged"
                                              Unchecked="OnSelectAllFileLocksChanged" />
                                    <TextBlock x:Name="FileLockSelectionText"
                                               FontSize="11"
                                               Foreground="{ThemeResource EdgeMutedBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="删除到回收站" Click="OnDeleteFileLockTargetClick" />
                                <Button Grid.Column="2" Content="结束进程后删除" Click="OnKillFileLockProcessesClick" />
                                <Button Grid.Column="3" Content="关闭句柄后删除" Click="OnCloseFileLockHandlesClick" />
                                <Button Grid.Column="4" Content="复制报告" Click="OnCopyFileLockReportClick" />
                            </Grid>
                        </Grid>
                    </Border>

                    <ListView x:Name="FileLocksList"
                              ItemTemplate="{StaticResource FileLockEntryTemplate}"
                              SelectionMode="None"
                              MaxHeight="560" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="SystemPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Spacing="12" Padding="0,0,8,0">
                    <Border Style="{StaticResource SectionCardStyle}">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="SnapshotSummaryText"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource EdgeTextBrush}" />
                            <TextBlock x:Name="OsText" Grid.Row="1"
                                       FontSize="12"
                                       Foreground="{ThemeResource EdgeTextBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="MachineText" Grid.Row="2"
                                       FontSize="12"
                                       Foreground="{ThemeResource EdgeTextBrush}" />
                            <TextBlock x:Name="CpuText" Grid.Row="3"
                                       FontSize="12"
                                       Foreground="{ThemeResource EdgeTextBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="MemoryText" Grid.Row="4"
                                       FontSize="12"
                                       Foreground="{ThemeResource EdgeTextBrush}" />
                            <TextBlock x:Name="SystemCompactSummaryText" Grid.Row="5"
                                       FontSize="12"
                                       Foreground="{ThemeResource EdgeMutedBrush}"
                                       TextWrapping="Wrap" />
                            <StackPanel Grid.Row="6"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        Margin="0,2,0,0">
                                <Button Content="复制摘要"
                                        Click="OnCopySystemSummaryClick" />
                                <Button Content="复制完整报告"
                                        Click="OnCopySnapshotClick" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="磁盘"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource EdgeTextBrush}" />
                    <GridView x:Name="SystemDrivesGrid"
                              ItemTemplate="{StaticResource DriveTemplate}"
                              SelectionMode="None"
                              IsItemClickEnabled="False"
                              Padding="0"
                              Margin="0,0,-8,0">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:ItemsWrapGrid Orientation="Horizontal" ItemWidth="118" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                    </GridView>
                </StackPanel>
            </ScrollViewer>

            <Border x:Name="Toast"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,8,8"
                    Padding="12,8"
                    CornerRadius="8"
                    Background="{ThemeResource EdgePanelBrush}"
                    BorderBrush="{ThemeResource EdgeLineBrush}"
                    BorderThickness="1"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14"
                              Glyph="&#xE73E;"
                              Foreground="{ThemeResource EdgeAccentBrush}" />
                    <TextBlock x:Name="ToastText"
                               FontSize="13"
                               Foreground="{ThemeResource EdgeTextBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
