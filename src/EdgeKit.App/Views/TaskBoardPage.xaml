<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="EdgeKit.App.Views.TaskBoardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:editors="using:Syncfusion.UI.Xaml.Editors"
    xmlns:local="using:EdgeKit.App.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:EdgeKit.App.ViewModels"
    Background="Transparent"
    Language="zh-CN"
    RequestedTheme="Dark"
    mc:Ignorable="d">

    <Page.Resources>
        <local:TaskCardPriorityToBrushConverter x:Key="PriorityToBrushConverter" />
        <local:TimeBucketToBrushConverter x:Key="TimeBucketToBrushConverter" />
        <local:OverdueToBrushConverter x:Key="OverdueToBrushConverter" />
        <local:TaskCardStatusToBarBrushConverter x:Key="StatusToBarBrushConverter" />

        <StaticResource x:Key="EdgeHoverBrush" ResourceKey="EdgeControlHoverBrush" />
        <StaticResource x:Key="EdgeSelectedBrush" ResourceKey="EdgeAccentSoftBrush" />

        <Style x:Key="PanelBorderStyle" TargetType="Border" BasedOn="{StaticResource EdgeCardBorderStyle}">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="{ThemeResource EdgeCardBrush}" />
        </Style>

        <Style x:Key="ToolButtonStyle" TargetType="Button" BasedOn="{StaticResource EdgeToolButtonStyle}">
            <Setter Property="Padding" Value="12,6" />
        </Style>

        <Style x:Key="FilterTabListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="OuterBorder"
                               Padding="12,6"
                               CornerRadius="8"
                               Background="{ThemeResource EdgeControlBrush}"
                               BorderBrush="{ThemeResource EdgeLineBrush}"
                               BorderThickness="1">
                            <ContentPresenter x:Name="ContentPresenter"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OuterBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource EdgeHoverBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Selected">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OuterBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource EdgeSelectedBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OuterBorder" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource EdgeLineBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="SelectedPointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OuterBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource EdgeSelectedBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="FilterTabTemplate" x:DataType="vm:TaskBoardFilterItem">
            <TextBlock Text="{x:Bind Display, Mode=OneWay}" FontSize="13"
                       Foreground="{ThemeResource EdgeTextBrush}" />
        </DataTemplate>

        <Style x:Key="BoardListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="OuterBorder"
                               Padding="12,12,14,12"
                               CornerRadius="8"
                               Background="{ThemeResource EdgeCardBrush}"
                               BorderBrush="{ThemeResource EdgeLineBrush}"
                               BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OuterBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource EdgeHoverBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OuterBorder" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource EdgeLineBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Selected">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OuterBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource EdgeSelectedBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OuterBorder" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource EdgeLineBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="SelectedUnfocused">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OuterBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource EdgeSelectedBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="GroupHeaderTemplate" x:DataType="vm:TaskCardGroupHeader">
            <Grid Padding="0">
                <TextBlock Text="{x:Bind Title}" FontSize="11"
                           Foreground="{ThemeResource EdgeMutedBrush}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TaskCardTemplate" x:DataType="vm:TaskCardViewModel">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Rectangle RadiusX="2" RadiusY="2"
                           Fill="{x:Bind Converter={StaticResource StatusToBarBrushConverter}}" />

                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="14"
                               Foreground="{ThemeResource EdgeTextBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind DescriptionPreview}" FontSize="12" MaxLines="2"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource EdgeMutedBrush}" />
                    
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Bind PriorityText}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{x:Bind Priority, Converter={StaticResource PriorityToBrushConverter}}" />
                        <TextBlock FontSize="11"
                                   Foreground="{x:Bind IsOverdue, Converter={StaticResource OverdueToBrushConverter}}">
                            <Run Text="{x:Bind DueText}" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="2"
                        Width="90"
                        Height="28"
                        FontSize="12"
                        VerticalAlignment="Center"
                        Background="{ThemeResource EdgeControlBrush}"
                        BorderBrush="{ThemeResource EdgeLineBrush}"
                        Content="{x:Bind StatusText}"
                        Tag="{x:Bind}">
                    <Button.Flyout>
                        <MenuFlyout Placement="Bottom"
                                    Opening="OnCardStatusFlyoutOpening">
                            <MenuFlyoutItem Text="待办" DataContext="0" Click="OnCardStatusFlyoutItemClick" />
                            <MenuFlyoutItem Text="进行中" DataContext="1" Click="OnCardStatusFlyoutItemClick" />
                            <MenuFlyoutItem Text="已完成" DataContext="2" Click="OnCardStatusFlyoutItemClick" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </DataTemplate>

        <local:TaskBoardItemTemplateSelector x:Key="BoardItemTemplateSelector"
                                             CardTemplate="{StaticResource TaskCardTemplate}"
                                             GroupHeaderTemplate="{StaticResource GroupHeaderTemplate}" />
    </Page.Resources>

    <Grid Padding="24,16,24,24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="待办任务" FontSize="22" FontWeight="SemiBold"
                       Foreground="{ThemeResource EdgeTextBrush}" />
            <TextBlock Text="按状态筛选，按时间分组"
                       FontSize="12" Foreground="{ThemeResource EdgeMutedBrush}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TitleInput" PlaceholderText="任务标题" />
                    <TextBox x:Name="DescriptionInput" Grid.Column="1" PlaceholderText="任务说明" />
                    <ComboBox x:Name="PriorityInput" Grid.Column="2" SelectedIndex="1"
                              Width="90"
                              Background="{ThemeResource EdgeControlBrush}"
                              BorderBrush="{ThemeResource EdgeLineBrush}">
                        <ComboBoxItem Content="低优先级" />
                        <ComboBoxItem Content="普通" />
                        <ComboBoxItem Content="高优先级" />
                    </ComboBox>
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <editors:SfDatePicker x:Name="DueDateInput"
                                          Width="180"
                                          Language="zh-CN"
                                          PlaceholderText="截止日期"
                                          DisplayDateFormat="yyyy-MM-dd"
                                          AllowNull="True" />
                    <editors:SfTimePicker x:Name="DueTimeInput" Grid.Column="1"
                                          Width="160"
                                          Language="zh-CN"
                                          PlaceholderText="截止时间"
                                          DisplayTimeFormat="HH:mm"
                                          AllowNull="True" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button x:Name="NewButton" Click="OnNewClick" Style="{StaticResource ToolButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="13" Glyph="&#xE710;" />
                                <TextBlock Text="新建" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SaveButton" Click="OnSaveClick" Style="{StaticResource ToolButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="13" Glyph="&#xE74E;" />
                                <TextBlock Text="保存" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DeleteButton" Click="OnDeleteClick" Style="{StaticResource ToolButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="13" Glyph="&#xE74D;" />
                                <TextBlock Text="删除" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <ListView x:Name="FilterTabs"
                  Grid.Row="2"
                  ItemsSource="{x:Bind _viewModel.Filters}"
                  ItemTemplate="{StaticResource FilterTabTemplate}"
                  ItemContainerStyle="{StaticResource FilterTabListViewItemStyle}"
                  SelectionMode="Single"
                  SelectedIndex="0"
                  SelectionChanged="OnFilterChanged"
                  ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                  ScrollViewer.HorizontalScrollMode="Enabled"
                  ScrollViewer.VerticalScrollMode="Disabled">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
        </ListView>

        <ListView x:Name="TaskList"
                  Grid.Row="3"
                  ItemsSource="{x:Bind _viewModel.GroupedItems}"
                  ItemTemplateSelector="{StaticResource BoardItemTemplateSelector}"
                  ItemContainerStyle="{StaticResource BoardListViewItemStyle}"
                  SelectionMode="Single"
                  SelectionChanged="OnCardSelectionChanged" />
    </Grid>
</Page>
