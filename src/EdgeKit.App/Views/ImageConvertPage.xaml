<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="EdgeKit.App.Views.ImageConvertPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    RequestedTheme="Dark"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="PanelBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="{ThemeResource EdgePanelBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource EdgeLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="ToolButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Background" Value="{ThemeResource EdgeControlBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource EdgeLineBrush}" />
        </Style>
    </Page.Resources>

    <Grid x:Name="RootGrid" Padding="24,16,24,24" RowSpacing="12" IsTabStop="True">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="V" Invoked="OnPasteAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Text="图片转换"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource EdgeTextBrush}" />
                <TextBlock x:Name="SubtitleText"
                           Text="导入图片后可转换格式、压缩并保存"
                           FontSize="12"
                           Foreground="{ThemeResource EdgeMutedBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="ConvertButton" Click="OnConvertClick" Style="{StaticResource ToolButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon FontSize="13" Glyph="&#xE8D4;" />
                        <TextBlock Text="转换" />
                    </StackPanel>
                </Button>
                <Button x:Name="SaveButton" Click="OnSaveClick" Style="{StaticResource ToolButtonStyle}" IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon FontSize="13" Glyph="&#xE74E;" />
                        <TextBlock Text="保存" />
                    </StackPanel>
                </Button>
                <Button x:Name="CopyButton" Click="OnCopyClick" Style="{StaticResource ToolButtonStyle}" IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon FontSize="13" Glyph="&#xE8C8;" />
                        <TextBlock Text="复制" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Click="OnPickFileClick" Style="{StaticResource ToolButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon FontSize="13" Glyph="&#xE8B7;" />
                    <TextBlock Text="选择文件" />
                </StackPanel>
            </Button>
            <Button Click="OnPasteClick" Style="{StaticResource ToolButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon FontSize="13" Glyph="&#xE77F;" />
                    <TextBlock Text="粘贴" />
                </StackPanel>
            </Button>
            <Button Click="OnClearClick" Style="{StaticResource ToolButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon FontSize="13" Glyph="&#xE74D;" />
                    <TextBlock Text="清空" />
                </StackPanel>
            </Button>
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource PanelBorderStyle}">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="源图片"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource EdgeTextBrush}" />
                        <TextBlock Grid.Column="1"
                                   x:Name="SourceMetaText"
                                   FontSize="12"
                                   Foreground="{ThemeResource EdgeMutedBrush}" />
                    </Grid>

                    <Border Grid.Row="1"
                            Background="{ThemeResource EdgeControlBrush}"
                            BorderBrush="{ThemeResource EdgeLineBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12">
                        <Grid>
                            <Image x:Name="SourceImage"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                            <TextBlock x:Name="SourcePlaceholderText"
                                       Text="导入图片后显示源预览"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource EdgeMutedBrush}" />
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="2"
                               x:Name="SourceInfoText"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource EdgeMutedBrush}" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="输出设置"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource EdgeTextBrush}" />
                        <TextBlock Grid.Column="1"
                                   x:Name="OutputMetaText"
                                   FontSize="12"
                                   Foreground="{ThemeResource EdgeMutedBrush}" />
                    </Grid>

                    <StackPanel Grid.Row="1" Spacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="目标格式"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource EdgeMutedBrush}" />
                            <ComboBox x:Name="FormatComboBox"
                                      Grid.Column="1"
                                      SelectionChanged="OnFormatChanged"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="PNG" Tag="png" />
                                <ComboBoxItem Content="JPG" Tag="jpg" />
                                <ComboBoxItem Content="WebP" Tag="webp" />
                                <ComboBoxItem Content="BMP" Tag="bmp" />
                            </ComboBox>
                        </Grid>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="QualityLabelText"
                                       Text="压缩强度"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource EdgeMutedBrush}" />
                            <Slider x:Name="QualitySlider"
                                    Grid.Column="1"
                                    Minimum="1"
                                    Maximum="100"
                                    Value="85"
                                    StepFrequency="1"
                                    ValueChanged="OnQualityChanged" />
                            <TextBlock x:Name="QualityValueText"
                                       Grid.Column="2"
                                       Text="85"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource EdgeMutedBrush}" />
                        </Grid>

                        <TextBlock x:Name="QualityHintText"
                                   FontSize="12"
                                   Foreground="{ThemeResource EdgeMutedBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Grid.Row="2"
                            Background="{ThemeResource EdgeControlBrush}"
                            BorderBrush="{ThemeResource EdgeLineBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12">
                        <Grid>
                            <Image x:Name="OutputImage"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                            <TextBlock x:Name="OutputPlaceholderText"
                                       Text="点击转换后显示输出预览"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource EdgeMutedBrush}" />
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="3"
                               x:Name="OutputInfoText"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource EdgeMutedBrush}" />
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3"
                   x:Name="StatusText"
                   Text="就绪"
                   FontSize="12"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Foreground="{ThemeResource EdgeMutedBrush}" />
    </Grid>
</Page>
