<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="EdgeKit.App.Views.ImageOcrPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    RequestedTheme="Dark"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="PanelBorderStyle" TargetType="Border" BasedOn="{StaticResource EdgeCardBorderStyle}">
            <Setter Property="Background" Value="{ThemeResource EdgeCardBrush}" />
        </Style>

        <Style x:Key="ToolButtonStyle" TargetType="Button" BasedOn="{StaticResource EdgeToolButtonStyle}">
        </Style>
    </Page.Resources>

    <Grid x:Name="RootGrid" Padding="24,16,24,24" RowSpacing="12" IsTabStop="True">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="V" Invoked="OnPasteAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Text="图片识别文字"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource EdgeTextBrush}" />
                <TextBlock Text="导入图片后识别其中的文字，支持离线识别"
                           FontSize="12"
                           Foreground="{ThemeResource EdgeMutedBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="RecognizeButton" Click="OnRecognizeClick" Style="{StaticResource ToolButtonStyle}" IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon FontSize="13" Glyph="&#xE8D4;" />
                        <TextBlock Text="识别" />
                    </StackPanel>
                </Button>
                <Button x:Name="CopyButton" Click="OnCopyClick" Style="{StaticResource ToolButtonStyle}" IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon FontSize="13" Glyph="&#xE8C8;" />
                        <TextBlock Text="复制" />
                    </StackPanel>
                </Button>
                <Button x:Name="SaveHistoryButton" Click="OnSaveHistoryClick" Style="{StaticResource ToolButtonStyle}" IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon FontSize="13" Glyph="&#xE7C3;" />
                        <TextBlock Text="保存到历史" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Click="OnPickFileClick" Style="{StaticResource ToolButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon FontSize="13" Glyph="&#xE8B7;" />
                    <TextBlock Text="选择文件" />
                </StackPanel>
            </Button>
            <Button Click="OnPasteClick" Style="{StaticResource ToolButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon FontSize="13" Glyph="&#xE77F;" />
                    <TextBlock Text="粘贴" />
                </StackPanel>
            </Button>
            <Button Click="OnClearClick" Style="{StaticResource ToolButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon FontSize="13" Glyph="&#xE74D;" />
                    <TextBlock Text="清空" />
                </StackPanel>
            </Button>
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource PanelBorderStyle}">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="源图片"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource EdgeTextBrush}" />

                    <Border Grid.Row="1"
                            Background="{ThemeResource EdgeControlBrush}"
                            BorderBrush="{ThemeResource EdgeLineBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12">
                        <Grid>
                            <Image x:Name="SourceImage"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                            <TextBlock x:Name="SourcePlaceholderText"
                                       Text="导入图片后显示源预览"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource EdgeMutedBrush}" />
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="2"
                               x:Name="SourceInfoText"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource EdgeMutedBrush}" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="识别结果"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource EdgeTextBrush}" />

                    <Border Grid.Row="1"
                            Background="{ThemeResource EdgeControlBrush}"
                            BorderBrush="{ThemeResource EdgeLineBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12">
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <TextBox x:Name="ResultTextBox"
                                         Text=""
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         IsReadOnly="True"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="0"
                                         Foreground="{ThemeResource EdgeTextBrush}"
                                         PlaceholderText="识别结果将显示在这里" />
                            </ScrollViewer>
                            <TextBlock x:Name="ResultPlaceholderText"
                                       Text="识别结果将显示在这里"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource EdgeMutedBrush}" />
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="2"
                               x:Name="ResultInfoText"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource EdgeMutedBrush}" />
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3"
                   x:Name="StatusText"
                   Text="就绪"
                   FontSize="12"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Foreground="{ThemeResource EdgeMutedBrush}" />
    </Grid>
</Page>
