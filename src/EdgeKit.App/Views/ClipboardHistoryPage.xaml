<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="EdgeKit.App.Views.ClipboardHistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:EdgeKit.App.ViewModels"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:EdgeKit.App.Controls"
    Background="Transparent"
    RequestedTheme="Dark"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- 历史卡片模板：左上类型角标，主体为摘要文本或图片缩略图。单击复制，右键弹菜单。 -->
        <DataTemplate x:Key="ClipboardCardTemplate" x:DataType="vm:ClipboardItemViewModel">
            <Border Height="120" CornerRadius="10" Padding="10"
                    HorizontalAlignment="Stretch"
                    Background="{ThemeResource EdgePanelBrush}"
                    BorderBrush="{ThemeResource EdgeLineBrush}" BorderThickness="1"
                    RightTapped="OnCardRightTapped">
                <Border.ContextFlyout>
                    <MenuFlyout Opening="OnCardFlyoutOpening" />
                </Border.ContextFlyout>

                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 顶部：类型角标 + 固定标记 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
                        <Border CornerRadius="6" Padding="6,2"
                                Background="{ThemeResource EdgeAccentSoftBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon FontSize="12"
                                          Foreground="{ThemeResource EdgeAccentBrush}"
                                          Glyph="{x:Bind KindGlyph, Mode=OneTime}" />
                                <TextBlock Text="{x:Bind KindLabel, Mode=OneTime}"
                                           FontSize="11"
                                           Foreground="{ThemeResource EdgeAccentBrush}" />
                            </StackPanel>
                        </Border>
                        <FontIcon FontSize="12" Glyph="&#xE718;"
                                  Foreground="{ThemeResource EdgeMutedBrush}"
                                  Visibility="{x:Bind Pinned, Mode=OneTime}" />
                        <Border CornerRadius="6" Padding="6,2"
                                Background="{ThemeResource EdgeControlBrush}"
                                Visibility="{x:Bind SourceVisibility, Mode=OneTime}">
                            <TextBlock Text="{x:Bind SourceAppName, Mode=OneTime}"
                                       MaxWidth="80"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="11"
                                       Foreground="{ThemeResource EdgeMutedBrush}" />
                        </Border>
                    </StackPanel>

                    <!-- 主体：文本摘要 -->
                    <TextBlock Grid.Row="1"
                               Text="{x:Bind Preview, Mode=OneTime}"
                               Foreground="{ThemeResource EdgeTextBrush}"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               MaxLines="4" FontSize="13"
                               Visibility="{x:Bind IsText, Mode=OneTime}">
                        <ToolTipService.ToolTip>
                            <ToolTip MaxWidth="520">
                                <ScrollViewer MaxHeight="360"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <TextBlock Text="{x:Bind FullContent, Mode=OneTime}"
                                               TextWrapping="WrapWholeWords"
                                               Foreground="{ThemeResource EdgeTextBrush}" />
                                </ScrollViewer>
                            </ToolTip>
                        </ToolTipService.ToolTip>
                    </TextBlock>

                    <!-- 主体：图片缩略图 -->
                    <Image Grid.Row="1"
                           Source="{x:Bind Thumbnail, Mode=OneTime}"
                           Stretch="Uniform" HorizontalAlignment="Left"
                           Visibility="{x:Bind IsImage, Mode=OneTime}" />

                    <!-- 底部：复制时间 -->
                    <TextBlock Grid.Row="2"
                               Text="{x:Bind TimeLabel, Mode=OneTime}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{ThemeResource EdgeMutedBrush}"
                               ToolTipService.ToolTip="{x:Bind AbsoluteTimeLabel, Mode=OneTime}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="PageRoot" Padding="24,16,24,16" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 + 工具条 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="剪贴板历史" FontSize="22" FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource EdgeTextBrush}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center">
                <Button x:Name="NewGroupButton" Click="OnNewGroupClick"
                        Background="{ThemeResource EdgeControlBrush}"
                        BorderBrush="{ThemeResource EdgeLineBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                        <TextBlock Text="新建分组" />
                    </StackPanel>
                </Button>
                <Button x:Name="AutoGroupButton" Click="OnAutoGroupClick"
                        Background="{ThemeResource EdgeControlBrush}"
                        BorderBrush="{ThemeResource EdgeLineBrush}">
                    <Grid>
                        <StackPanel x:Name="AutoGroupNormalContent"
                                    Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE9D2;" />
                            <TextBlock Text="自动分组" />
                        </StackPanel>
                        <StackPanel x:Name="AutoGroupLoadingContent"
                                    Orientation="Horizontal" Spacing="6"
                                    Visibility="Collapsed">
                            <ProgressRing Width="16" Height="16" IsActive="True" />
                            <TextBlock Text="分组中…" />
                        </StackPanel>
                    </Grid>
                </Button>
                <Button x:Name="ClearButton" Click="OnClearClick"
                        Background="{ThemeResource EdgeControlBrush}"
                        BorderBrush="{ThemeResource EdgeLineBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                        <TextBlock Text="清空" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 分组筛选 + 全局搜索：搜索时查全部分组里的历史。 -->
        <Grid Grid.Row="1">
            <!-- 默认收起：分组横向滚动 + 展开按钮 + 搜索框 -->
            <Grid x:Name="GroupFilterCollapsedRow" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0"
                              HorizontalScrollMode="Auto"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden">
                    <ItemsControl x:Name="GroupFilterBar">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <Button x:Name="ExpandGroupsButton"
                         Grid.Column="1"
                         Click="OnToggleGroupExpandClick"
                         Background="Transparent"
                         BorderBrush="Transparent"
                         Padding="6,0"
                         VerticalAlignment="Center">
                    <FontIcon x:Name="ExpandGroupsIcon"
                               FontSize="12"
                               Glyph="&#xE970;"
                               Foreground="{ThemeResource EdgeMutedBrush}" />
                </Button>

                <Grid x:Name="CollapsedSearchPlaceholder" Grid.Column="2">
                    <Border x:Name="SearchBoxContainer"
                             Height="36"
                             CornerRadius="8"
                             Background="{ThemeResource EdgeControlBrush}"
                             BorderBrush="{ThemeResource EdgeLineBrush}"
                             BorderThickness="1">
                        <Grid Padding="10,0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE721;"
                                      FontSize="14"
                                      Foreground="{ThemeResource EdgeMutedBrush}" />
                            <TextBox x:Name="ClipboardSearchInput"
                                     Grid.Column="1"
                                     PlaceholderText="搜索历史或来源"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalAlignment="Center"
                                     TextChanged="OnClipboardSearchTextChanged">
                                <TextBox.Resources>
                                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                </TextBox.Resources>
                            </TextBox>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- 展开：分组占满整行，最多两行并纵向滚动，搜索框位于下方 -->
            <Grid x:Name="GroupFilterExpandedRow"
                  Visibility="Collapsed"
                  RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer x:Name="ExpandedGroupScrollViewer"
                                  Grid.Column="0"
                                  SizeChanged="OnExpandedGroupScrollViewerSizeChanged"
                                  VerticalScrollMode="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollMode="Disabled"
                                  HorizontalScrollBarVisibility="Hidden"
                                  MaxHeight="88">
                        <ItemsControl x:Name="GroupFilterBarExpanded"
                                      HorizontalAlignment="Left">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <local:WrapPanel HorizontalSpacing="8"
                                                    VerticalSpacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Grid.Column="1"
                             Click="OnToggleGroupExpandClick"
                             Background="Transparent"
                             BorderBrush="Transparent"
                             Padding="6,0"
                             VerticalAlignment="Center">
                        <FontIcon FontSize="12"
                                   Glyph="&#xE972;"
                                   Foreground="{ThemeResource EdgeMutedBrush}" />
                    </Button>
                </Grid>

                <Grid x:Name="ExpandedSearchPlaceholder" Grid.Row="1" />
            </Grid>
        </Grid>

        <!-- 历史网格：WrapGrid 横向排布，按可用宽度自动换行（一行多个），列宽随宽度自适应均分。 -->
        <Grid Grid.Row="2" SizeChanged="OnGridSizeChanged">
            <GridView x:Name="ItemsGrid"
                      Padding="0"
                      Margin="0,0,-12,0"
                      IsItemClickEnabled="True"
                      SelectionMode="None"
                      ItemClick="OnItemClick"
                      ItemTemplate="{StaticResource ClipboardCardTemplate}">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:ItemsWrapGrid x:Name="ItemsWrapGrid" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Margin" Value="0,0,12,12" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </GridView.ItemContainerStyle>
            </GridView>

            <StackPanel x:Name="EmptyHint"
                        Spacing="10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <TextBlock Text="还没有剪贴板记录，复制点什么试试"
                           FontSize="13"
                           Foreground="{ThemeResource EdgeMutedBrush}"
                           TextAlignment="Center" />
            </StackPanel>
        </Grid>

        <Border x:Name="CopyToast"
                Grid.RowSpan="3"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,0,8"
                Padding="12,8"
                CornerRadius="8"
                Background="{ThemeResource EdgePanelBrush}"
                BorderBrush="{ThemeResource EdgeLineBrush}"
                BorderThickness="1"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon x:Name="CopyToastIcon"
                          FontSize="14"
                          Glyph="&#xE73E;"
                          Foreground="{ThemeResource EdgeAccentBrush}" />
                <TextBlock x:Name="CopyToastText"
                           Text="已复制到剪贴板"
                           FontSize="13"
                           Foreground="{ThemeResource EdgeTextBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
