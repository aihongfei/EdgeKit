<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="EdgeKit.App.Views.ToolPlaceholderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                Spacing="14" Padding="24">
        <Border Width="72" Height="72" CornerRadius="18"
                HorizontalAlignment="Center"
                Background="{ThemeResource EdgeAccentSoftBrush}"
                BorderBrush="{ThemeResource EdgeAccentBrush}" BorderThickness="1">
            <FontIcon x:Name="ToolIcon" FontSize="32"
                      Foreground="{ThemeResource EdgeAccentBrush}"
                      Glyph="&#xE82F;" />
        </Border>

        <TextBlock x:Name="TitleText" Text="工具" FontSize="20" FontWeight="SemiBold"
                   HorizontalAlignment="Center" />
        <TextBlock x:Name="DescText" Text="" FontSize="13"
                   Foreground="{ThemeResource EdgeMutedBrush}"
                   TextAlignment="Center" MaxWidth="280" TextWrapping="Wrap" />

        <Border CornerRadius="8" Padding="12,6" HorizontalAlignment="Center"
                Background="{ThemeResource EdgeControlBrush}"
                BorderBrush="{ThemeResource EdgeLineBrush}" BorderThickness="1">
            <TextBlock Text="开发中" FontSize="12"
                       Foreground="{ThemeResource EdgeMutedBrush}" />
        </Border>
    </StackPanel>
</Page>
