<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="EdgeKit.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:EdgeKit.App.ViewModels"
    Background="Transparent"
    RequestedTheme="Dark"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="HomeGridViewItemStyle" TargetType="GridViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource EdgeAccentBrush}" />
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent" />
            <Setter Property="FocusVisualPrimaryThickness" Value="1" />
            <Setter Property="FocusVisualSecondaryThickness" Value="0" />
            <Setter Property="FocusVisualMargin" Value="4" />
        </Style>

        <Style x:Key="HomeListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource EdgeAccentBrush}" />
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent" />
            <Setter Property="FocusVisualPrimaryThickness" Value="1" />
            <Setter Property="FocusVisualSecondaryThickness" Value="0" />
            <Setter Property="FocusVisualMargin" Value="4" />
        </Style>

        <Style x:Key="HomeClipboardListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource EdgeAccentBrush}" />
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent" />
            <Setter Property="FocusVisualPrimaryThickness" Value="1" />
            <Setter Property="FocusVisualSecondaryThickness" Value="0" />
            <Setter Property="FocusVisualMargin" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="HoverOverlay.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="HoverOverlay.Opacity" Value="1" />
                                            <Setter Target="HoverOverlay.Background" Value="#33FFFFFF" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Selected" />
                                    <VisualState x:Name="PointerOverSelected">
                                        <VisualState.Setters>
                                            <Setter Target="HoverOverlay.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PressedSelected">
                                        <VisualState.Setters>
                                            <Setter Target="HoverOverlay.Opacity" Value="1" />
                                            <Setter Target="HoverOverlay.Background" Value="#33FFFFFF" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />

                            <!-- 悬浮高亮层，与卡片同尺寸同圆角，覆盖在内容上方 -->
                            <Border x:Name="HoverOverlay"
                                    CornerRadius="8"
                                    Background="#1AFFFFFF"
                                    Opacity="0"
                                    IsHitTestVisible="False" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 快速启动磁贴：图标在上，名称在下；加号磁贴复用同一模板。 -->
        <DataTemplate x:Key="QuickLaunchTileTemplate" x:DataType="vm:QuickLaunchTileViewModel">
            <Grid Width="84" Height="92" Padding="4"
                  RightTapped="OnQuickLaunchTileRightTapped">
                <StackPanel Visibility="{x:Bind ItemVisibility, Mode=OneTime}"
                            Spacing="6" HorizontalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="10"
                            Background="{ThemeResource EdgeControlBrush}"
                            BorderBrush="{ThemeResource EdgeLineBrush}" BorderThickness="1"
                            HorizontalAlignment="Center">
                        <Grid>
                            <Image Width="28" Height="28"
                                   Source="{x:Bind IconImage, Mode=OneTime}"
                                   Visibility="{x:Bind IconVisibility, Mode=OneTime}" />
                            <FontIcon FontSize="18"
                                      Foreground="{ThemeResource EdgeAccentBrush}"
                                      Glyph="{x:Bind Glyph, Mode=OneTime}"
                                      Visibility="{x:Bind GlyphVisibility, Mode=OneTime}" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{x:Bind Title, Mode=OneTime}"
                               Width="76" TextAlignment="Center"
                               Foreground="{ThemeResource EdgeTextBrush}"
                               FontSize="12" TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="2" />
                </StackPanel>

                <StackPanel Visibility="{x:Bind AddVisibility, Mode=OneTime}"
                            Spacing="6" HorizontalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="10"
                            Background="{ThemeResource EdgeControlBrush}"
                            BorderBrush="{ThemeResource EdgeLineBrush}" BorderThickness="1"
                            HorizontalAlignment="Center">
                        <FontIcon FontSize="18"
                                  Foreground="{ThemeResource EdgeAccentBrush}"
                                  Glyph="&#xE710;" />
                    </Border>
                    <TextBlock Text="添加"
                               Width="76" TextAlignment="Center"
                               Foreground="{ThemeResource EdgeMutedBrush}"
                               FontSize="12" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- 最近使用磁贴：复用快速启动的上下结构，图标在上，名称在下。 -->
        <DataTemplate x:Key="RecentUsageTileTemplate" x:DataType="vm:RecentItemViewModel">
            <Grid Width="84" Height="92" Padding="4">
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="10"
                            Background="{ThemeResource EdgeControlBrush}"
                            BorderBrush="{ThemeResource EdgeLineBrush}" BorderThickness="1"
                            HorizontalAlignment="Center">
                        <Grid>
                            <Image Width="28" Height="28"
                                   Source="{x:Bind IconImage, Mode=OneTime}"
                                   Visibility="{x:Bind HasIconImage, Mode=OneTime}" />
                            <FontIcon FontSize="18"
                                      Foreground="{ThemeResource EdgeAccentBrush}"
                                      Glyph="{x:Bind Glyph, Mode=OneTime}"
                                      Visibility="{x:Bind HasNoIconImage, Mode=OneTime}" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{x:Bind Title, Mode=OneTime}"
                               Width="76" TextAlignment="Center"
                               Foreground="{ThemeResource EdgeTextBrush}"
                               FontSize="12" TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="2" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- 最近项卡片模板：左侧图标（位图或字形/首字母占位），右侧标题 + 副标题。 -->
        <DataTemplate x:Key="RecentItemTemplate" x:DataType="vm:RecentItemViewModel">
            <Grid Padding="10,8" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 图标区：40x40 圆角方块。 -->
                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                        Background="{ThemeResource EdgeControlBrush}"
                        BorderBrush="{ThemeResource EdgeLineBrush}" BorderThickness="1">
                    <Grid>
                        <!-- 应用位图图标。 -->
                        <Image Width="28" Height="28"
                               Source="{x:Bind IconImage, Mode=OneTime}"
                               Visibility="{x:Bind HasIconImage, Mode=OneTime}" />
                        <!-- 无位图时：有字形用字形，否则用首字母。 -->
                        <FontIcon FontSize="18"
                                  Foreground="{ThemeResource EdgeAccentBrush}"
                                  Glyph="{x:Bind Glyph, Mode=OneTime}"
                                  Visibility="{x:Bind HasNoIconImage, Mode=OneTime}" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind Title, Mode=OneTime}"
                               Foreground="{ThemeResource EdgeTextBrush}"
                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                    <TextBlock Text="{x:Bind SubTitle, Mode=OneTime}"
                               FontSize="12" Foreground="{ThemeResource EdgeMutedBrush}"
                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- 当前活动窗口：一行多个长形卡片，展示标题与进程信息。 -->
        <DataTemplate x:Key="ActiveWindowCardTemplate" x:DataType="vm:ManagedWindowViewModel">
            <Grid Width="220" Height="68" Padding="10,8" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="40" Height="40" CornerRadius="10"
                        Background="{ThemeResource EdgeControlBrush}"
                        BorderBrush="{ThemeResource EdgeLineBrush}" BorderThickness="1"
                        VerticalAlignment="Center">
                    <Grid>
                        <Image Width="28" Height="28"
                               Source="{x:Bind IconImage, Mode=OneTime}"
                               Visibility="{x:Bind HasIconImage, Mode=OneTime}" />
                        <FontIcon FontSize="18"
                                  Foreground="{ThemeResource EdgeAccentBrush}"
                                  Glyph="{x:Bind Glyph, Mode=OneTime}"
                                  Visibility="{x:Bind HasNoIconImage, Mode=OneTime}" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind Title, Mode=OneTime}"
                               Foreground="{ThemeResource EdgeTextBrush}"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="1" />
                    <TextBlock Text="{x:Bind SubTitle, Mode=OneTime}"
                               FontSize="12"
                               Foreground="{ThemeResource EdgeMutedBrush}"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="1" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- 首页剪贴板卡片模板：固定宽高，横向展示最近 5 条。 -->
        <DataTemplate x:Key="HomeClipboardItemTemplate" x:DataType="vm:ClipboardItemViewModel">
            <Border Width="164" Height="112" CornerRadius="8" Padding="10"
                    Background="{ThemeResource EdgePanelBrush}"
                    BorderBrush="{ThemeResource EdgeLineBrush}" BorderThickness="1">
                <ToolTipService.ToolTip>
                    <ToolTip MaxWidth="520">
                        <ScrollViewer MaxHeight="360"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <TextBlock Text="{x:Bind FullContent, Mode=OneTime}"
                                       TextWrapping="WrapWholeWords"
                                       Foreground="{ThemeResource EdgeTextBrush}" />
                        </ScrollViewer>
                    </ToolTip>
                </ToolTipService.ToolTip>

                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
                        <Border CornerRadius="6" Padding="6,2"
                                Background="{ThemeResource EdgeAccentSoftBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon FontSize="12"
                                          Foreground="{ThemeResource EdgeAccentBrush}"
                                          Glyph="{x:Bind KindGlyph, Mode=OneTime}" />
                                <TextBlock Text="{x:Bind KindLabel, Mode=OneTime}"
                                           FontSize="11"
                                           Foreground="{ThemeResource EdgeAccentBrush}" />
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="6" Padding="6,2"
                                Background="{ThemeResource EdgeControlBrush}"
                                Visibility="{x:Bind SourceVisibility, Mode=OneTime}">
                            <TextBlock Text="{x:Bind SourceAppName, Mode=OneTime}"
                                       MaxWidth="64"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="11"
                                       Foreground="{ThemeResource EdgeMutedBrush}" />
                        </Border>
                    </StackPanel>

                    <TextBlock Grid.Row="1"
                               Text="{x:Bind Preview, Mode=OneTime}"
                               Foreground="{ThemeResource EdgeTextBrush}"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               MaxLines="3" FontSize="13"
                               Visibility="{x:Bind IsText, Mode=OneTime}" />

                    <Image Grid.Row="1"
                           Source="{x:Bind Thumbnail, Mode=OneTime}"
                           Stretch="Uniform" HorizontalAlignment="Left"
                           Visibility="{x:Bind IsImage, Mode=OneTime}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <ScrollViewer Padding="24,16,24,24">
            <StackPanel Spacing="18" HorizontalAlignment="Stretch">

            <TextBlock Text="首页" FontSize="22" FontWeight="SemiBold"
                       Foreground="{ThemeResource EdgeTextBrush}" />

            <!-- 最近使用（操作历史，从数据库读取） -->
            <StackPanel Spacing="8">
                <TextBlock Text="最近使用" FontSize="14" FontWeight="SemiBold"
                           Foreground="{ThemeResource EdgeMutedBrush}" />

                <GridView x:Name="ToolsList"
                          MaxHeight="184"
                          Padding="0"
                          Margin="0"
                          SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="OnToolItemClick"
                          KeyDown="OnHomeCardsKeyDown"
                          ItemTemplate="{StaticResource RecentUsageTileTemplate}"
                          ItemContainerStyle="{StaticResource HomeGridViewItemStyle}"
                          ScrollViewer.VerticalScrollMode="Enabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal"
                                           ItemWidth="84"
                                           ItemHeight="92" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                </GridView>

                <TextBlock x:Name="ToolsEmpty" Text="还没有使用过工具，去左侧菜单点几个试试"
                           FontSize="12" Foreground="{ThemeResource EdgeMutedBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- 快速启动 -->
            <StackPanel x:Name="QuickLaunchSection" Spacing="8">
                <TextBlock Text="快速启动" FontSize="14" FontWeight="SemiBold"
                           Foreground="{ThemeResource EdgeMutedBrush}" />

                <GridView x:Name="QuickLaunchGrid"
                          Padding="0"
                          Margin="0"
                          SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="OnQuickLaunchItemClick"
                          KeyDown="OnHomeCardsKeyDown"
                          ItemTemplate="{StaticResource QuickLaunchTileTemplate}"
                          ItemContainerStyle="{StaticResource HomeGridViewItemStyle}"
                          ScrollViewer.VerticalScrollMode="Enabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal"
                                           ItemWidth="84"
                                           ItemHeight="92" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                </GridView>
            </StackPanel>

            <!-- 活动窗口 -->
            <StackPanel Spacing="8">
                <TextBlock Text="活动窗口" FontSize="14" FontWeight="SemiBold"
                           Foreground="{ThemeResource EdgeMutedBrush}" />

                <GridView x:Name="WindowsList"
                          Padding="0"
                          Margin="0"
                          SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="OnWindowItemClick"
                          KeyDown="OnHomeCardsKeyDown"
                          ItemContainerStyle="{StaticResource HomeGridViewItemStyle}"
                          ItemTemplate="{StaticResource ActiveWindowCardTemplate}"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          ScrollViewer.HorizontalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal"
                                           ItemWidth="228"
                                           ItemHeight="76" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                </GridView>

                <TextBlock x:Name="WindowsEmpty" Text="当前没有可显示的应用窗口"
                           FontSize="12" Foreground="{ThemeResource EdgeMutedBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- 最近剪贴板历史 -->
            <StackPanel x:Name="ClipboardSection" Spacing="8">
                <TextBlock Text="剪贴板历史" FontSize="14" FontWeight="SemiBold"
                           Foreground="{ThemeResource EdgeMutedBrush}" />

                <ListView x:Name="ClipboardList"
                          Height="126"
                          Padding="0"
                          Margin="0"
                          SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="OnClipboardItemClick"
                          KeyDown="OnHomeCardsKeyDown"
                          ItemTemplate="{StaticResource HomeClipboardItemTemplate}"
                          ItemContainerStyle="{StaticResource HomeClipboardListViewItemStyle}"
                          ScrollViewer.HorizontalScrollMode="Enabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Hidden">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                </ListView>

                <TextBlock x:Name="ClipboardEmpty" Text="还没有剪贴板历史"
                           FontSize="12" Foreground="{ThemeResource EdgeMutedBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <Border x:Name="CopyToast"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,24,24"
                Padding="12,8"
                CornerRadius="8"
                Background="{ThemeResource EdgePanelBrush}"
                BorderBrush="{ThemeResource EdgeLineBrush}"
                BorderThickness="1"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon x:Name="CopyToastIcon"
                          FontSize="14"
                          Glyph="&#xE73E;"
                          Foreground="{ThemeResource EdgeAccentBrush}" />
                <TextBlock x:Name="CopyToastText"
                           Text="已复制到剪贴板"
                           FontSize="13"
                           Foreground="{ThemeResource EdgeTextBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
