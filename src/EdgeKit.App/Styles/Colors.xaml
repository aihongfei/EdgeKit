<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Black Glass palette. Keep the legacy Edge* keys so existing pages stay wired. -->
    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Default">
            <Color x:Key="EdgeAccentColor">#6DBBFF</Color>
            <Color x:Key="EdgeAccentStrongColor">#A8D8FF</Color>
            <Color x:Key="EdgeSurfaceTintColor">#08090A</Color>

            <SolidColorBrush x:Key="EdgeAccentBrush" Color="{StaticResource EdgeAccentColor}" />
            <SolidColorBrush x:Key="EdgeAccentStrongBrush" Color="{StaticResource EdgeAccentStrongColor}" />
            <SolidColorBrush x:Key="EdgeAccentSoftBrush" Color="#2B6DBBFF" />
            <SolidColorBrush x:Key="EdgeAccentSubtleBrush" Color="#1C6DBBFF" />

            <SolidColorBrush x:Key="EdgeDrawerOverlayBrush" Color="#78050607" />
            <SolidColorBrush x:Key="EdgeBackdropBrush" Color="#9A08090A" />

            <SolidColorBrush x:Key="EdgePanelBrush" Color="#76111214" />
            <SolidColorBrush x:Key="EdgeCardBrush" Color="#8217191D" />
            <SolidColorBrush x:Key="EdgeCardElevatedBrush" Color="#981D2025" />
            <SolidColorBrush x:Key="EdgeControlBrush" Color="#6A1B1D21" />
            <SolidColorBrush x:Key="EdgeControlHoverBrush" Color="#8225282D" />
            <SolidColorBrush x:Key="EdgeControlPressedBrush" Color="#9630343A" />
            <SolidColorBrush x:Key="EdgeLineBrush" Color="#3DFFFFFF" />
            <SolidColorBrush x:Key="EdgeLineStrongBrush" Color="#55FFFFFF" />
            <SolidColorBrush x:Key="EdgeDividerBrush" Color="#24FFFFFF" />

            <LinearGradientBrush x:Key="EdgeGlassPanelBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#94191B1F" />
                <GradientStop Offset="0.48" Color="#76111214" />
                <GradientStop Offset="1" Color="#6208090A" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="EdgeGlassCardBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#9A1D2025" />
                <GradientStop Offset="0.55" Color="#8217191D" />
                <GradientStop Offset="1" Color="#6808090A" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="EdgeGlassControlBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#8225282D" />
                <GradientStop Offset="0.55" Color="#6A1B1D21" />
                <GradientStop Offset="1" Color="#5208090A" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="EdgeTextBrush" Color="#F7FAFC" />
            <SolidColorBrush x:Key="EdgeMutedBrush" Color="#B8C2CC" />
            <SolidColorBrush x:Key="EdgeSubtleTextBrush" Color="#7F8A96" />

            <SolidColorBrush x:Key="EdgeSuccessBrush" Color="#32D583" />
            <SolidColorBrush x:Key="EdgeWarningBrush" Color="#F7C948" />
            <SolidColorBrush x:Key="EdgeDangerBrush" Color="#FF6678" />
            <SolidColorBrush x:Key="EdgeCyanBrush" Color="#35D6E8" />
            <SolidColorBrush x:Key="EdgePinkBrush" Color="#FF7ABF" />
            <SolidColorBrush x:Key="EdgePurpleBrush" Color="#B7A6FF" />

            <SolidColorBrush x:Key="ButtonBackground" Color="#6A1B1D21" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#8225282D" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#9630343A" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#3DFFFFFF" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#55FFFFFF" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#73FFFFFF" />
            <SolidColorBrush x:Key="ButtonForeground" Color="#F7FAFC" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#F7FAFC" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#F7FAFC" />

            <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource EdgeAccentColor}" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{StaticResource EdgeAccentStrongColor}" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#4FA8F5" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#3A6DBBFF" />

            <SolidColorBrush x:Key="TextControlBackground" Color="#6A1B1D21" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#8225282D" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#9630343A" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#3DFFFFFF" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#55FFFFFF" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource EdgeAccentColor}" />
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#7F8A96" />

            <SolidColorBrush x:Key="ComboBoxBackground" Color="#6A1B1D21" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#8225282D" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#9630343A" />
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#3DFFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#55FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="{StaticResource EdgeAccentColor}" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <Color x:Key="EdgeAccentColor">#2563EB</Color>
            <Color x:Key="EdgeAccentStrongColor">#1D4ED8</Color>
            <Color x:Key="EdgeSurfaceTintColor">#F3F6FA</Color>

            <SolidColorBrush x:Key="EdgeAccentBrush" Color="{StaticResource EdgeAccentColor}" />
            <SolidColorBrush x:Key="EdgeAccentStrongBrush" Color="{StaticResource EdgeAccentStrongColor}" />
            <SolidColorBrush x:Key="EdgeAccentSoftBrush" Color="#1F2563EB" />
            <SolidColorBrush x:Key="EdgeAccentSubtleBrush" Color="#142563EB" />

            <SolidColorBrush x:Key="EdgeDrawerOverlayBrush" Color="#B8F8FAFD" />
            <SolidColorBrush x:Key="EdgeBackdropBrush" Color="#EAF8FAFD" />

            <SolidColorBrush x:Key="EdgePanelBrush" Color="#D9FFFFFF" />
            <SolidColorBrush x:Key="EdgeCardBrush" Color="#EFFFFFFF" />
            <SolidColorBrush x:Key="EdgeCardElevatedBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="EdgeControlBrush" Color="#BFFFFFFF" />
            <SolidColorBrush x:Key="EdgeControlHoverBrush" Color="#E5FFFFFF" />
            <SolidColorBrush x:Key="EdgeControlPressedBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="EdgeLineBrush" Color="#24000000" />
            <SolidColorBrush x:Key="EdgeLineStrongBrush" Color="#33000000" />
            <SolidColorBrush x:Key="EdgeDividerBrush" Color="#18000000" />

            <LinearGradientBrush x:Key="EdgeGlassPanelBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#FFFFFFFF" />
                <GradientStop Offset="1" Color="#EFFFFFFF" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="EdgeGlassCardBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#FAFFFFFF" />
                <GradientStop Offset="1" Color="#E8FFFFFF" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="EdgeGlassControlBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#F2FFFFFF" />
                <GradientStop Offset="1" Color="#DFFFFFFF" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="EdgeTextBrush" Color="#E6000000" />
            <SolidColorBrush x:Key="EdgeMutedBrush" Color="#A0000000" />
            <SolidColorBrush x:Key="EdgeSubtleTextBrush" Color="#73000000" />

            <SolidColorBrush x:Key="EdgeSuccessBrush" Color="#047857" />
            <SolidColorBrush x:Key="EdgeWarningBrush" Color="#B45309" />
            <SolidColorBrush x:Key="EdgeDangerBrush" Color="#DC2626" />
            <SolidColorBrush x:Key="EdgeCyanBrush" Color="#0F766E" />
            <SolidColorBrush x:Key="EdgePinkBrush" Color="#BE185D" />
            <SolidColorBrush x:Key="EdgePurpleBrush" Color="#6D28D9" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <Color x:Key="EdgeAccentColor">#FFFFFFFF</Color>
            <Color x:Key="EdgeAccentStrongColor">#FFFFFFFF</Color>
            <Color x:Key="EdgeSurfaceTintColor">#FF000000</Color>

            <SolidColorBrush x:Key="EdgeAccentBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="EdgeAccentSoftBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EdgeAccentStrongBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="EdgeAccentSubtleBrush" Color="{ThemeResource SystemColorHighlightColor}" />

            <SolidColorBrush x:Key="EdgeDrawerOverlayBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="EdgeBackdropBrush" Color="{ThemeResource SystemColorWindowColor}" />

            <SolidColorBrush x:Key="EdgePanelBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="EdgeCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="EdgeCardElevatedBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="EdgeControlBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="EdgeControlHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EdgeControlPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EdgeLineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="EdgeLineStrongBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="EdgeDividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />

            <SolidColorBrush x:Key="EdgeGlassPanelBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="EdgeGlassCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="EdgeGlassControlBrush" Color="{ThemeResource SystemColorWindowColor}" />

            <SolidColorBrush x:Key="EdgeTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="EdgeMutedBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="EdgeSubtleTextBrush" Color="{ThemeResource SystemColorGrayTextColor}" />

            <SolidColorBrush x:Key="EdgeSuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="EdgeWarningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="EdgeDangerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="EdgeCyanBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="EdgePinkBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="EdgePurpleBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <CornerRadius x:Key="EdgeRadiusXs">5</CornerRadius>
    <CornerRadius x:Key="EdgeRadiusSm">6</CornerRadius>
    <CornerRadius x:Key="EdgeRadiusMd">8</CornerRadius>
    <CornerRadius x:Key="EdgeRadiusLg">10</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>

    <Thickness x:Key="EdgePagePadding">24,16,24,24</Thickness>
    <Thickness x:Key="EdgePanelPadding">12</Thickness>
    <Thickness x:Key="EdgeButtonPadding">10,5</Thickness>

    <x:Double x:Key="EdgeSectionSpacing">12</x:Double>
    <x:Double x:Key="EdgeControlHeight">34</x:Double>

    <Style x:Key="EdgeCardBorderStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource EdgeRadiusMd}" />
        <Setter Property="Padding" Value="{StaticResource EdgePanelPadding}" />
        <Setter Property="Background" Value="{ThemeResource EdgeGlassPanelBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource EdgeLineStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="EdgeToolButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="{StaticResource EdgeControlHeight}" />
        <Setter Property="Padding" Value="{StaticResource EdgeButtonPadding}" />
        <Setter Property="Background" Value="{ThemeResource EdgeControlBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource EdgeLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource EdgeRadiusMd}" />
    </Style>
</ResourceDictionary>
